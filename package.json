		"url": "https://github.com/JoeKarlsson/bechdel-test"
	},
	"keywords": [
		"bechdel",
		"bechdel test",
		"feminism",
		"film",
		"movie script",
		"screenplay",
		"parser"
	],
	"author": "Joe Karlsson & Laurel Karlsson",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/JoeKarlsson/bechdel-test/issues"
	},
	"homepage": "https://bechdel.joekarlsson.com/",
	"scripts": {
		"analyze": "node scripts/analyze.js",
		"test": "jest",
		"lint": "eslint src scripts",
		"match": "node scripts/match.js",
		"eval": "node scripts/eval.js",
		"ratings": "node scripts/fetch-ratings.js",
		"fetch-scripts": "node scripts/fetch-scripts.js",
		"fetch-script-slug": "node scripts/fetch-script-slug.js",
		"recover-scripts": "node scripts/recover-scripts.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.2.0",
		"jest": "^30.5.2",
		"prettier": "^3.3.0"
	},
	"overrides": {
		"minimatch@>=7.0.0 <11.0.1": "11.0.1"
