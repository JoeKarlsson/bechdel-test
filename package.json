{
	"name": "bechdel-test",
	"version": "2.0.0",
	"private": true,
	"description": "Analyzes screenplays for the Bechdel Test and writes the film data the static site in site/ builds from.",
	"engines": {
		"node": ">=22"
	},
	"repository": {
