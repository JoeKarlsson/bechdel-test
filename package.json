{
	"name": "Bechdel_Test",
	"version": "1.0.1",
	"engines": {
		"node": ">=16.0.0"
	},
	"description": "A node based interactive site to analyze a movie script in order to tell if it passes the Bechdel Test.",
	"main": "server/server.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/JoeKarlsson/bechdel-test"
	},
	"keywords": [
		"express",
		"webpack",
		"node",
		"react",
		"bechdel",
		"bechdel Test",
		"Feminism",
		"Feminist",
		"Film",
		"movie",
		"script",
		"parser",
		"movie script",
		"feminist theory"
	],
	"author": "Joe Karlsson & Laurel Karlsson",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/JoeKarlsson/bechdel-test/issues"
	},
	"homepage": "https://github.com/JoeKarlsson/bechdel-test",
	"scripts": {
		"start": "NODE_ENV=development node src/server/server.js",
		"start:dev": "NODE_ENV=development nodemon src/server/server.js",
		"start:local": "NODE_ENV=development MONGODB_URI=mongodb://localhost:27017/bechdelTest node src/server/server.js",
		"stop": "killall -s KILL node",
		"test": "jest --coverage",
		"coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
		"test:watch": "jest --watch",
		"test:updateSnapshot": "jest --updateSnapshot",
		"test:coverage": "jest --coverage",
		"lint": "eslint src && npm run lint:css && npm run lint:md",
		"lint:fix": "npm run lint -- --fix",
		"lint:out": "npm run lint -- -f checkstyle -o coverage/checkstyle.xml",
		"lint:css": "stylelint 'src/**/*.scss' --syntax scss",
		"lint:css:fix": "stylelint 'src/**/*.scss' --syntax scss --fix",
		"lint:md": "remark .",
		"healthcheck": "npm run lint && npm run test:coverage",
		"processScript": "nodemon src/server/helper/processScript.js",
		"build": "rimraf dist && NODE_ENV=production webpack --config ./webpack.config.prod.js --progress --profile",
		"build:analyze": "ANALYZE=true npm run build",
		"build:stats": "rimraf dist && NODE_ENV=production webpack --config ./webpack.config.prod.js --profile --json > webpack-stats.json",
		"runProd": "NODE_ENV=production node src/server/server.js",
		"snyk-protect": "snyk protect",
		"prepublish": "npm run snyk-protect"
	},
	"dependencies": {
		"@babel/plugin-transform-react-jsx": "^7.8.3",
		"@testing-library/dom": "^10.4.1",
		"@uppy/core": "^1.7.1",
		"@uppy/dashboard": "^1.5.2",
		"@uppy/react": "^1.4.2",
		"@uppy/xhr-upload": "^1.4.2",
		"body-parser": "^1.20.3",
		"connect-history-api-fallback": "^2.0.0",
		"coveralls": "^3.0.9",
		"css-loader": "^3.4.2",
		"es6-promise": "^4.2.8",
		"express": "^4.21.2",
		"express-partials": "^0.3.0",
		"fetch-mock": "5.13.1",
		"helmet": "^7.2.0",
		"history": "^4.10.1",
		"html-webpack-plugin": "^5.6.4",
		"identity-obj-proxy": "3.0.0",
		"isomorphic-fetch": "2.2.1",
		"jest-fetch-mock": "^3.0.1",
		"method-override": "2.3.10",
		"mini-css-extract-plugin": "^0.9.0",
		"mockingoose": "^2.13.2",
		"mongoose": "^6.12.0",
		"multer": "^1.3.0",
		"nock": "9.1.6",
		"nyc": "^15.0.0",
		"prettier-stylelint": "^0.4.2",
		"prop-types": "^15.8.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router": "^6.30.1",
		"react-router-dom": "^6.30.1",
		"react-test-renderer": "^18.3.1",
		"recharts": "^1.0.0-beta.9",
		"remark-cli": "^7.0.1",
		"remark-lint": "6.0.1",
		"remark-preset-lint-recommended": "3.0.1",
		"rimraf": "^6.0.1",
		"sass": "^1.69.0",
		"sass-loader": "^8.0.2",
		"snyk": "^1.290.1",
		"stats-webpack-plugin": "^0.7.0",
		"style-loader": "^1.1.3",
		"stylelint": "^13.0.0",
		"stylelint-config-recommended-scss": "^4.2.0",
		"stylelint-scss": "^3.14.2",
		"stylelint-webpack-plugin": "^5.0.1",
		"supertest": "3.0.0",
		"util": "^0.12.5",
		"webpack-dev-middleware": "^6.1.0",
		"webpack-hot-middleware": "^2.26.1"
	},
	"devDependencies": {
		"@babel/core": "^7.28.4",
		"@babel/preset-env": "^7.28.3",
		"@babel/preset-react": "^7.27.1",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"autoprefixer": "^10.4.20",
		"babel-jest": "^28.1.3",
		"babel-loader": "^9.2.1",
		"cross-env": "^7.0.3",
		"css-minimizer-webpack-plugin": "^7.0.2",
		"eslint": "^8.57.0",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-jsx-a11y": "^6.8.0",
		"eslint-plugin-prettier": "^5.1.3",
		"eslint-plugin-react": "^7.34.1",
		"jest": "^28.1.3",
		"jest-environment-jsdom": "^28.1.3",
		"nodemon": "^3.1.10",
		"postcss-loader": "^8.1.1",
		"prettier": "^3.3.0",
		"pretty-quick": "^1.3.0",
		"terser-webpack-plugin": "^5.3.14",
		"webpack": "^5.101.3",
		"webpack-bundle-analyzer": "^4.10.2",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^4.15.2"
	},
	"optionalDependencies": {
		"husky": "^0.14.3"
	},
	"snyk": true
}
