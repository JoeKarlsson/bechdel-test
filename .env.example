# Bechdel Test Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# API Keys
# ============================================

# The AI read goes through the homelab LiteLLM gateway (only needed with --ai).
# The key is the LiteLLM virtual key "bechdel" (macOS Keychain: litellm-bechdel-key),
# scoped to the one alias below. Off the LAN, 192.168.0.230 needs Tailscale.
LITELLM_BASE_URL=http://192.168.0.230:4000
LITELLM_API_KEY=sk-bechdel-xxxxx
AI_MODEL=cloud-coder

# The Movie Database API Key (required: cast, genders, posters)
# Get your key at: https://www.themoviedb.org/settings/api
THEMOVIEDB=your_tmdb_api_key_here

# OMDB API Key (required: npm run analyze looks films up by title here)
# Get your key at: http://www.omdbapi.com/apikey.aspx
OMDB=your_omdb_api_key_here
