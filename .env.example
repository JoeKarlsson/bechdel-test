# Bechdel Test Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# API Keys
# ============================================

# Claude AI API Key (for the AI read; not needed with npm run analyze -- --no-ai)
# Get your key at: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-xxxxx

# The Movie Database API Key (required: cast, genders, posters)
# Get your key at: https://www.themoviedb.org/settings/api
THEMOVIEDB=your_tmdb_api_key_here

# OMDB API Key (required: npm run analyze looks films up by title here)
# Get your key at: http://www.omdbapi.com/apikey.aspx
OMDB=your_omdb_api_key_here
