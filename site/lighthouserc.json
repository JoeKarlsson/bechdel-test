{
	"ci": {
		"collect": {
			"staticDistDir": "./dist",
			"url": [
				"/",
				"/films/gone-girl-2014/",
				"/films/fight-club-1999/",
				"/about/"
			],
			"numberOfRuns": 3
		},
		"assert": {
			"assertions": {
				"categories:performance": [
					"error",
					{
						"minScore": 0.9
					}
				],
				"categories:accessibility": [
					"error",
					{
						"minScore": 0.9
					}
				],
				"categories:best-practices": [
					"error",
					{
						"minScore": 0.9
					}
				],
				"categories:seo": [
					"error",
					{
						"minScore": 0.9
					}
				]
			},
			"aggregationMethod": "median-run"
		},
		"upload": {
			"target": "filesystem",
			"outputDir": "./.lighthouseci"
		}
	}
}
