---
// Share targets, as under joekarlsson.com posts and Punc books. Each click is a
// Plausible event (tagged-events script), named by network.
interface Props {
	url: string;
	title: string;
}
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title.slice(0, 80));
const both = encodeURIComponent(`${title} ${url}`);
const NETWORKS = [
	['Bluesky', `https://bsky.app/intent/compose?text=${both}`],
	['Threads', `https://www.threads.net/intent/post?text=${both}`],
	['Reddit', `https://www.reddit.com/submit?url=${u}&title=${t}`],
	['Hacker News', `https://news.ycombinator.com/submitlink?u=${u}&t=${t}`],
	['X', `https://x.com/intent/post?text=${t}&url=${u}`],
];
---

<p class="share">
	Share it on
	{
		NETWORKS.map(([label, href], i) => [
			<a href={href} target="_blank" rel="noopener noreferrer" class={`plausible-event-name=Share+Click plausible-event-network=${label.replace(/ /g, '+')}`}>{label}</a>,
			i < NETWORKS.length - 1 ? ', ' : '',
		])
	}, or <button type="button" class="copy plausible-event-name=Copy+Link" data-copy-link={url}
		><span class="copy-label">copy the link</span><span class="copy-done" aria-hidden="true">link copied</span></button
	>.
</p>

<script>
	// Copies the page link and says so; leaves the button as a plain link otherwise
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-link]')) {
		// Both labels share one grid cell, so the button keeps its width while they crossfade
		const label = button.querySelector<HTMLElement>('.copy-label')!;
		const done = button.querySelector<HTMLElement>('.copy-done')!;
		const original = label.textContent;
		let reset: number | undefined;
		button.addEventListener('click', async () => {
			clearTimeout(reset);
			try {
				await navigator.clipboard.writeText(button.dataset.copyLink ?? location.href);
				button.dataset.copied = '';
				label.setAttribute('aria-hidden', 'true');
				done.removeAttribute('aria-hidden');
			} catch {
				label.textContent = 'press and hold the address bar to copy';
			}
			reset = window.setTimeout(() => {
				delete button.dataset.copied;
				label.textContent = original;
				label.removeAttribute('aria-hidden');
				done.setAttribute('aria-hidden', 'true');
			}, 2500);
		});
	}
</script>

<style>
	.share {
		margin: 0;
		line-height: 2;
	}
	.share a {
		padding: var(--space-1) 0;
	}
	.copy {
		background: none;
		border: 0;
		padding: var(--space-1) 0;
		color: var(--pink);
		font: inherit;
		text-decoration: underline;
		text-underline-offset: 0.15em;
		cursor: pointer;
	}
	.copy:hover {
		color: var(--chalk);
	}
	.copy {
		display: inline-grid;
		justify-items: start;
	}
	.copy > span {
		grid-area: 1 / 1;
		transition:
			opacity 150ms ease-out,
			filter 150ms ease-out,
			scale 150ms ease-out;
	}
	.copy-done,
	.copy[data-copied] .copy-label {
		opacity: 0;
		scale: 0.9;
		filter: blur(3px);
	}
	.copy[data-copied] .copy-done {
		opacity: 1;
		scale: 1;
		filter: none;
	}
	.copy[data-copied] {
		animation: copied-pulse 240ms ease-out;
	}
	@keyframes copied-pulse {
		35% {
			scale: 1.08;
		}
	}
</style>
