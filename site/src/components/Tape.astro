---
// One film on the shelf: its poster in a tape box, a PASSES or FAILS sticker,
// and a label with the year and Bechdel score.
import { posterFor } from '../lib/images';

interface Props {
	film: {
		id: string;
		slug: string;
		title: string;
		year: number | null;
		directors: string[];
		popularity: number;
		bechdel: { score: number; pass: boolean };
		images: { poster: string | null };
	};
	/** The first row loads right away; the rest wait until scrolled to */
	eager?: boolean;
}

const { film, eager = false } = Astro.props;
const poster = posterFor(film.images.poster);
const verdict = film.bechdel.pass ? 'Passes' : 'Fails';
---

<li
	class="tape"
	data-slug={film.slug}
	data-title={film.title.toLowerCase()}
	data-director={film.directors.join(' ').toLowerCase()}
	data-score={film.bechdel.score}
	data-year={film.year ?? 0}
	data-popularity={film.popularity}
>
	<a href={`/films/${film.slug}/`}>
		<div class="box">
			{
				poster ? (
					<img
						src={poster.src}
						srcset={poster.srcset}
						sizes="(max-width: 560px) 31vw, 180px"
						width={poster.width}
						height={poster.height}
						alt=""
						loading={eager ? 'eager' : 'lazy'}
						decoding="async"
						class="poster"
					/>
				) : (
					<span class="blank" aria-hidden="true">
						<span>{film.title}</span>
					</span>
				)
			}
			<span class="label">
				<span class="title">{film.title}</span>
				<span class="meta">{film.year}, {film.bechdel.score} of 3<span class="rules-word"> rules</span></span>
			</span>
			<span class:list={['sticker', film.bechdel.pass ? 'pass' : 'fail']}>{verdict}</span>
		</div>
		<span class="plank" aria-hidden="true"></span>
	</a>
</li>

<style>
	/* Boxes stretch to the tallest label in the row, so the planks line up */
	.tape a {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: var(--chalk);
		text-decoration: none;
	}
	.box {
		flex: 1;
		display: flex;
		flex-direction: column;
		position: relative;
		background: var(--shelf);
		padding: var(--space-2) var(--space-2) 0;
	}
	.poster,
	.blank {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
	}
	.blank {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--panel);
		padding: var(--space-3);
	}
	.blank span {
		background: var(--chalk);
		color: var(--ink);
		padding: var(--space-2) var(--space-3);
		font-family: var(--poster);
		font-size: 1.375rem;
		line-height: 1.1;
		text-transform: uppercase;
		text-align: center;
		transform: rotate(-3deg);
	}
	.label {
		display: block;
		flex: 1;
		background: var(--chalk);
		color: var(--ink);
		padding: var(--space-2);
		margin: 0 calc(-1 * var(--space-2));
	}
	.title {
		font-family: var(--poster);
		font-size: 1.1875rem;
		line-height: 1.1;
		text-transform: uppercase;
		/* Up to three lines, so "The Lord of the Rings" films can be told apart */
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.meta {
		display: block;
		font-size: var(--text-small);
	}
	.sticker {
		position: absolute;
		top: var(--space-3);
		right: calc(-1 * var(--space-2));
		font-family: var(--poster);
		font-size: 1.0625rem;
		line-height: 1;
		text-transform: uppercase;
		padding: 0.45rem 0.6rem;
		color: var(--ink);
		transform: rotate(6deg);
	}
	.sticker.pass {
		background: var(--pink);
	}
	.sticker.fail {
		background: var(--fail);
	}
	.plank {
		display: block;
		height: 10px;
		background: var(--plank);
	}
	@media (max-width: 560px) {
		.box {
			padding: var(--space-1) var(--space-1) 0;
		}
		.label {
			margin: 0 calc(-1 * var(--space-1));
			padding: var(--space-1);
		}
		.title,
		.meta {
			font-size: 1rem;
		}
		.meta .rules-word {
			display: none;
		}
		.sticker {
			font-size: 1rem;
			padding: 0.3rem 0.4rem;
			top: var(--space-2);
			right: calc(-1 * var(--space-1));
		}
	}
	a:hover .title,
	a:focus-visible .title {
		text-decoration: underline;
	}
	/* Pulled off the shelf: the box lifts and tilts, the plank stays put. The
	   separate translate/rotate/scale properties leave the sticker's own
	   transform alone. Lifting eases out; settling back is a move, not an exit
	   (the box stays on screen), so it eases in and out, and it's quicker. */
	.box {
		transition:
			translate 130ms var(--ease-move),
			rotate 130ms var(--ease-move),
			scale 100ms ease-out;
	}
	@media (hover: hover) and (pointer: fine) {
		a:hover .box {
			translate: 0 -6px;
			rotate: -1deg;
			transition-duration: 160ms;
			transition-timing-function: var(--ease-enter);
		}
	}
	a:focus-visible .box {
		translate: 0 -6px;
		rotate: -1deg;
	}
	a:active .box {
		scale: 0.97;
		transition-duration: 60ms;
	}
</style>
