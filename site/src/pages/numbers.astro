---
import OnThisPage from '../components/OnThisPage.astro';
import Base from '../layouts/Base.astro';
import YearChart from '../components/YearChart.astro';
import PeopleRanking from '../components/PeopleRanking.astro';
import Tape from '../components/Tape.astro';
import { loadFilms, shelfStats, peopleRanking } from '../lib/films.mjs';

const films = loadFilms();
const s = shelfStats(films);

// Counts over 999 get a thousands comma, like the rest of the site
const n = (x: number) => x.toLocaleString('en-US');
const pct = (n: number, d: number) => Math.round((n / d) * 100);
const percent = (x: number | null) => (x === null ? '?' : `${Math.round(x * 100)}%`);
const times = (x: number | null) => (x === null ? '?' : `${x.toFixed(1)} times`);

// Every chart on the page is one bar per row on a 0-100% track
type Row = { label: string; share: number; value: string; aria: string };
const passPoints = s.byYear.map((y) => ({
	year: y.year,
	value: y.pass / y.films,
	average: y.fiveYearPass,
	says: `${y.year}: ${n(y.pass)} of ${n(y.films)} films pass (${pct(y.pass, y.films)}%). Five years around it: ${percent(y.fiveYearPass)}.`,
}));
const linesPoints = s.byYear
	.filter((y) => y.womenLines !== null)
	.map((y) => ({
		year: y.year,
		value: y.womenLines!,
		average: y.fiveYearWomenLines!,
		says: `${y.year}: women have ${percent(y.womenLines)} of the lines in the median film. Five years around it: ${percent(y.fiveYearWomenLines)}.`,
	}));
const firstYear = s.byYear[0].year;

// How far the films get: the three rules are cumulative
const SCORE_NAMES = ['Fewer than two women', 'Two women who never talk', 'They talk, only about a man', 'Passes'];
const scoreRows = s.scores.map((r) => ({
	label: SCORE_NAMES[r.score],
	share: r.films / s.films,
	value: r.films.toLocaleString('en-US'),
	aria: `${SCORE_NAMES[r.score]}: ${r.films} films, ${pct(r.films, s.films)}%`,
	pass: r.score === 3,
}));

const MIN_DIRECTOR_FILMS = 8;
const directorRanking = peopleRanking(films, (f) => f.directors, MIN_DIRECTOR_FILMS);
// Stars: the top three billed in each film
const MIN_STAR_FILMS = 10;
const STAR_LIST = 10;
const starRanking = peopleRanking(films, (f) => f.cast.slice(0, 3).map((c) => c.actor), MIN_STAR_FILMS);
const womenStars = new Set(films.flatMap((f) => f.cast.slice(0, 3).filter((c) => c.gender === 'w').map((c) => c.actor)));
const starWomen = starRanking.filter((p) => womenStars.has(p.name)).length;
const genreRows: Row[] = s.byGenre.map((g) => ({
	label: g.label,
	share: g.pass / g.films,
	value: `${n(g.pass)} of ${n(g.films)}`,
	aria: `${g.label}: ${n(g.pass)} of ${n(g.films)} films pass`,
}));
const JOB_NAMES: Record<string, string> = {
	'Directed by': 'Directors',
	'Written by': 'Writers',
	'Produced by': 'Producers',
	'Shot by': 'Cinematographers',
	'Edited by': 'Editors',
	'Music by': 'Composers',
	'Production design by': 'Production designers',
	'Costumes by': 'Costume designers',
	'Cast by': 'Casting directors',
};
const jobRows: Row[] = s.jobs.map((j) => {
	const known = j.w + j.m + j.nb;
	return {
		label: JOB_NAMES[j.label] ?? j.label,
		share: j.w / known,
		value: `${n(j.w)} of ${n(known)}`,
		aria: `${JOB_NAMES[j.label] ?? j.label}: ${n(j.w)} of ${n(known)} credits with a listed gender are women`,
	};
});
const directors = s.jobs.find((j) => j.label === 'Directed by');
const shooters = s.jobs.find((j) => j.label === 'Shot by');
const h = s.heard;

// Last words: who has the first and last line
const lw = s.lastWords;
type Ends = typeof lw.first;
const womenOf = (x: Ends) => x.wLead + x.wSide;
const leadsOf = (x: Ends) => x.wLead + x.mLead;
const STACK_PARTS = [
	{ key: 'wLead', css: 'w lead', label: 'Woman, a lead' },
	{ key: 'wSide', css: 'w side', label: 'Woman, side character' },
	{ key: 'mLead', css: 'm lead', label: 'Man, a lead' },
	{ key: 'mSide', css: 'm side', label: 'Man, side character' },
	{ key: 'unknown', css: 'unknown', label: 'Gender not known: narrators, voices, crowds' },
] as const;
const stackRows = (['first', 'last'] as const).map((end) => ({
	label: end === 'first' ? 'First line' : 'Last line',
	counts: lw[end],
	aria: `${end === 'first' ? 'First' : 'Last'} line: ${STACK_PARTS.map((p) => `${p.label} ${pct(lw[end][p.key], lw[end].films)}%`).join(', ')}`,
}));
const decadeName = (d: number) => (d === 1970 ? 'Before 1980' : `${d}s`);
const decadeRows = (end: 'first' | 'last'): Row[] =>
	lw.byDecade.map((d) => ({
		label: decadeName(d.decade),
		share: d[end].w / d[end].films,
		value: `${pct(d[end].w, d[end].films)}%`,
		aria: `${decadeName(d.decade)}: ${n(d[end].w)} of ${n(d[end].films)} films ${end === 'first' ? 'open' : 'end'} on a woman's line`,
	}));
const passRows: Row[] = [
	{ label: 'Passes', ...lw.pass },
	{ label: 'Fails', ...lw.fail },
].map((r) => ({ label: r.label, share: r.w / r.films, value: `${pct(r.w, r.films)}%`, aria: `Films that ${r.label.toLowerCase().replace(/s$/, '')}: ${n(r.w)} of ${n(r.films)} end on a woman's line` }));
// The best-rated films' last lines, three said by women and three by men
const byRating = films.filter((f) => f.bookends?.last && f.imdbRating !== null).sort((a, b) => b.imdbRating! - a.imdbRating!);
const lastOf = (gender: 'w' | 'm') => byRating.filter((f) => f.bookends!.last!.gender === gender).slice(0, 3);
const quotes = lastOf('w').flatMap((f, i) => [f, lastOf('m')[i]]).filter(Boolean);

// Page vs screen: the scripts against the films' subtitles
const ps = s.pageVsScreen;
const DRAFT_NAMES: Record<string, string> = { shooting: 'Shooting drafts', early: 'Early drafts', unknown: 'Drafts of unknown date' };
const draftRows: Row[] = ps.byDraft.map((d) => ({
	label: DRAFT_NAMES[d.draft],
	share: d.survival ?? 0,
	value: percent(d.survival),
	aria: `${DRAFT_NAMES[d.draft]}: in the median film, ${percent(d.survival)} of the script's words are heard (${d.films} films)`,
}));
// What each page verdict becomes on screen
const FLOWS = [
	{ label: 'Pass on the page', ...ps.flows.pass, flipLabel: 'fail on screen' },
	{ label: 'Fail on the page', ...ps.flows.fail, flipLabel: 'pass on screen' },
].map((f) => ({
	...f,
	parts: [
		{ label: 'same on screen', count: f.same, css: 'same' },
		{ label: f.flipLabel, count: f.flips, css: 'flip' },
		{ label: 'unclear', count: f.unclear, css: 'unclear' },
	],
}));
const survivalMax = Math.max(1, ...ps.survivalBins);
const PASSING_NAMES = ['Under 10 seconds', '10 to 30 seconds', '30 seconds to a minute', '1 to 2 minutes', '2 to 5 minutes', 'Over 5 minutes'];
const passingFilms = ps.passingBins.reduce((a, b) => a + b, 0);
const passingRows: Row[] = ps.passingBins.map((c, k) => ({
	label: PASSING_NAMES[k],
	share: c / Math.max(1, passingFilms),
	value: n(c),
	aria: `${PASSING_NAMES[k]}: ${c} films`,
}));
const cutRows = [
	{ label: 'Two women talking', share: ps.conversations.w.conversation, men: false },
	{ label: "Women's other lines", share: ps.conversations.w.other, men: false },
	{ label: 'Two men talking', share: ps.conversations.m.conversation, men: true },
	{ label: "Men's other lines", share: ps.conversations.m.other, men: true },
].map((r) => ({ ...r, share: r.share ?? 0, value: percent(r.share), aria: `${r.label}: ${percent(r.share)} cut in the median film` }));
// the best-known films whose verdict changes, as tapes
const SHELF_ROW = 6;

// The page's sections, for the contents list at the top
const CONTENTS = [
	{ id: 'trust-title', label: 'How far to trust these' },
	{ id: 'time-title', label: 'Year by year' },
	{ id: 'fail-title', label: 'How far films get' },
	{ id: 'genre-title', label: 'By genre' },
	{ id: 'heard-title', label: 'Who gets heard' },
	...(ps.films > 0 ? [{ id: 'screen-title', label: 'Page vs screen' }] : []),
	{ id: 'words-title', label: 'Last words' },
	{ id: 'crew-title', label: 'Behind the camera' },
	{ id: 'directors-title', label: 'By director' },
	{ id: 'stars-title', label: 'By star' },
	{ id: 'ages-title', label: 'How old the stars were' },
	{ id: 'money-title', label: 'The money' },
];
---

<Base
	title="The shelf in numbers"
	description={`All ${n(s.films)} films on the shelf, counted: pass rates by year, genre, director and star, who gets heard, who made the films, and what they earned.`}
	nav="numbers"
>
	<div class="page">
		<h1 class="page-title">The shelf in numbers</h1>
		<p class="page-lead">{n(s.films)} films. {n(s.pass)} of them pass the Bechdel test, {pct(s.pass, s.films)}%.</p>
		<OnThisPage items={CONTENTS} />

		<section class="section">
			<h2 id="trust-title" class="section-title">How far to trust these</h2>
			<div class="prose">
				<p>
					The scores come from our script parser. Where bechdeltest.com's readers have rated a film, the parser agrees with them on
					pass or fail for {n(s.readers.agree)} of {n(s.readers.films)} films ({pct(s.readers.agree, s.readers.films)}%). Each film's page
					shows the readers' score next to ours.
				</p>
				<p>
					The shelf is the scripts we could find online: mostly Hollywood films from the 1980s to the 2010s, many of them action
					films. It isn't a sample of all films, so read the numbers below as describing this shelf.
				</p>
			</div>
		</section>

		<section class="section">
			<h2 id="time-title" class="section-title">Year by year</h2>
			<div class="two">
				<YearChart title="Films that pass" points={passPoints} />
				<YearChart title="Women's share of the lines" points={linesPoints} />
			</div>
			<p class="note">
				Gray dots are single years; the pink line pools the five years around each one. The share of lines is for the median film,
				counting lines whose speaker we could place. Years with fewer than ten films on the shelf, all of them before {firstYear}, are
				left out.
			</p>
			<details class="table-view">
				<summary>The numbers by year</summary>
				<table>
					<thead>
						<tr><th scope="col">Year</th><th scope="col">Films</th><th scope="col">Pass</th><th scope="col">Women's lines</th></tr>
					</thead>
					<tbody>
						{s.byYear.map((y) => (
							<tr><th scope="row">{y.year}</th><td>{y.films}</td><td>{y.pass} ({pct(y.pass, y.films)}%)</td><td>{percent(y.womenLines)}</td></tr>
						))}
					</tbody>
				</table>
			</details>
		</section>

		<section class="section">
			<h2 id="fail-title" class="section-title">How far films get</h2>
			<ul class="hbars wide-labels score-labels">
				{scoreRows.map((r) => (
					<li>
						<div class="hb-row" role="img" aria-label={r.aria}>
							<span class="hb-label">{r.label}</span>
							<span class="hb-track"><span class:list={['hb-bar', { fail: !r.pass }]} style={`width: ${(r.share * 100).toFixed(1)}%`} /></span>
							<span class="hb-value">{r.value}</span>
						</div>
					</li>
				))}
			</ul>
			<p class="note">The three rules build on each other, so each film counts once, at the last rule it clears.</p>
		</section>

		<section class="section">
			<h2 id="genre-title" class="section-title">By genre</h2>
			<ul class="hbars wide-labels">
				{genreRows.map((r) => (
					<li>
								<div class="hb-row" role="img" aria-label={r.aria}>
						<span class="hb-label">{r.label}</span>
						<span class="hb-track">{r.share > 0 && <span class="hb-bar" style={`width: ${(r.share * 100).toFixed(1)}%`} />}</span>
						<span class="hb-value">{r.value}</span>
						</div>
					</li>
				))}
			</ul>
			<p class="note">Most films have more than one genre, so they count in each. Genres with fewer than five films are left out.</p>
		</section>

		<section class="section">
			<h2 id="heard-title" class="section-title">Who gets heard</h2>
			<dl class="tiles">
				<div>
					<dt>{percent(h.womenWordShare)}</dt>
					<dd>of the words are spoken by women, in the median film.</dd>
				</div>
				<div>
					<dt>{h.menConversations.toLocaleString('en-US')}</dt>
					<dd>conversations between two named men, against {h.womenConversations.toLocaleString('en-US')} between two named women.</dd>
				</div>
				<div>
					<dt>{pct(h.reversePass, h.films)}%</dt>
					<dd>
						of films pass the test run the other way: two named men who talk about something besides a woman. {pct(s.pass, s.films)}%
						pass the Bechdel test.
					</dd>
				</div>
			</dl>
		</section>

		{
			ps.films > 0 && (
				<section class="section">
					<h2 id="screen-title" class="section-title">Page vs screen</h2>
					<p class="section-lead">{n(ps.films)} scripts lined up with what's said in the film. <a href="/about/#page-vs-screen">How we compare</a></p>
					<dl class="tiles">
						<div>
							<dt>{percent(ps.survival)}</dt>
							<dd>of a script's words are heard in the film</dd>
						</div>
						<div>
							<dt>{Math.round(ps.passing.seconds!)} seconds</dt>
							<dd>of women talking to each other is enough to pass</dd>
						</div>
						<div>
							<dt>{percent((ps.passToFail.length + ps.failToPass.length) / ps.films)}</dt>
							<dd>of films get a different verdict on screen</dd>
						</div>
					</dl>
					<p class="note">The first two are for the median film.</p>

					<h3>The verdict on screen</h3>
					<ul class="flows">
						{FLOWS.map((f) => (
							<li>
								<p class="flow-label">{f.label} <span class="note">{n(f.films)} films</span></p>
								<div class="flow-bar" role="img" aria-label={`${f.label}, ${f.films} films: ${f.parts.map((p) => `${p.label} ${p.count}`).join(', ')}`}>
									{f.parts.map((p) => p.count > 0 && <span class:list={['flow-part', p.css]} style={`flex-grow: ${p.count}`} />)}
								</div>
								<p class="note flow-values">{f.parts.map((p) => `${p.label}: ${n(p.count)}`).join(', ')}</p>
							</li>
						))}
					</ul>
					<ul class="legend small">
						<li><span class="swatch flow-swatch same" />Same verdict</li>
						<li><span class="swatch flow-swatch flip" />Different verdict</li>
						<li><span class="swatch flow-swatch unclear" />Depends on who says lines that aren't in the script</li>
					</ul>

					<div class="two">
						<div>
							<h3>How much of the script is heard</h3>
							<div class="columns" role="img" aria-label={`Films by share of the script's words heard: ${ps.survivalBins.map((c, k) => `${k * 10} to ${k * 10 + 10}%: ${c}`).join(', ')}`}>
								{ps.survivalBins.map((c) => <span class="column" style={`height: ${((c / survivalMax) * 100).toFixed(1)}%`} />)}
							</div>
							<p class="note axis-ends"><span>0%</span><span>50%</span><span>100%</span></p>
							<p class="note">Films, by share of the script's words heard on screen</p>
						</div>
						<div>
							<h3>How long the passing talk lasts</h3>
							<ul class="hbars wide-labels">
								{passingRows.map((r) => (
									<li>
										<div class="hb-row" role="img" aria-label={r.aria}>
											<span class="hb-label">{r.label}</span>
											<span class="hb-track">{r.share > 0 && <span class="hb-bar" style={`width: ${(r.share * 100).toFixed(1)}%`} />}</span>
											<span class="hb-value">{r.value}</span>
										</div>
									</li>
								))}
							</ul>
							<p class="note">Films that pass on screen, by how long women talk to each other in all</p>
						</div>
					</div>

					<div class="two">
						<div>
							<h3>Which lines get cut</h3>
							<ul class="hbars wide-labels">
								{cutRows.map((r) => (
									<li>
										<div class="hb-row" role="img" aria-label={r.aria}>
											<span class="hb-label">{r.label}</span>
											<span class="hb-track"><span class:list={['hb-bar', { neutral: r.men }]} style={`width: ${(r.share * 100).toFixed(1)}%`} /></span>
											<span class="hb-value">{r.value}</span>
										</div>
									</li>
								))}
							</ul>
							<p class="note">Share of each kind of line cut, in the median film</p>
						</div>
						{draftRows.length > 1 && (
							<div>
								<h3>Words heard, by kind of script</h3>
								<ul class="hbars wide-labels">
									{draftRows.map((r) => (
										<li>
											<div class="hb-row" role="img" aria-label={r.aria}>
												<span class="hb-label">{r.label}</span>
												<span class="hb-track">{r.share > 0 && <span class="hb-bar neutral" style={`width: ${(r.share * 100).toFixed(1)}%`} />}</span>
												<span class="hb-value">{r.value}</span>
											</div>
										</li>
									))}
								</ul>
							</div>
						)}
					</div>

					{[
						{ title: 'Passes on the page, fails on screen', list: ps.passToFail },
						{ title: 'Fails on the page, passes on screen', list: ps.failToPass },
					].map(({ title, list }) => list.length > 0 && (
						<>
							<h3>{title}</h3>
							<ul class="shelf-row poster-grid">
								{list.slice(0, SHELF_ROW).map((film) => <Tape film={film} />)}
							</ul>
							{list.length > SHELF_ROW && (
								<details class="table-view">
									<summary>All {n(list.length)} films</summary>
									<ul class="film-list">
										{[...list].sort((a, b) => a.title.localeCompare(b.title)).map((f) => <li><a href={`/films/${f.slug}/`}>{f.title}</a> ({f.year})</li>)}
									</ul>
								</details>
							)}
						</>
					))}
					<p class="note">
						Left out: {ps.excluded.map((x) => `${n(x.films)} because ${x.reason}`).join('; ')}.
					</p>
				</section>
			)
		}

		<section class="section">
			<h2 id="words-title" class="section-title">Last words</h2>
			<dl class="tiles">
				<div>
					<dt>{pct(womenOf(lw.last), lw.last.films)}%</dt>
					<dd>of films end on a woman's line. Women speak {percent(lw.womenLineShare)} of all the lines.</dd>
				</div>
				<div>
					<dt>{pct(womenOf(lw.first), lw.first.films)}%</dt>
					<dd>of films open on a woman's line.</dd>
				</div>
				<div>
					<dt>{pct(lw.ledByWoman.w, lw.ledByWoman.films)}%</dt>
					<dd>of films where a woman has the most lines end on a woman's line. Where a man has the most, {pct(lw.ledByMan.w, lw.ledByMan.films)}% do.</dd>
				</div>
			</dl>

			<h3>Who speaks first and last</h3>
			<div class="stack-rows">
				{stackRows.map((r) => (
					<>
						<p class="stack-label">{r.label}</p>
						<div class="stack" role="img" aria-label={r.aria}>
							{STACK_PARTS.map((p) => r.counts[p.key] > 0 && <span class:list={['stack-part', p.css]} style={`flex-grow: ${r.counts[p.key]}`} />)}
						</div>
					</>
				))}
			</div>
			<ul class="legend">
				{STACK_PARTS.map((p) => <li><span class:list={['swatch', 'stack-swatch', p.css]} />{p.label}</li>)}
			</ul>
			<div class="prose">
				<p>
					Leads have the first line in {pct(leadsOf(lw.first), lw.first.films)}% of films and the last in {pct(leadsOf(lw.last), lw.last.films)}%.
					When a woman has the last line she's a lead {pct(lw.last.wLead, womenOf(lw.last))}% of the time; when a man does, {pct(lw.last.mLead, lw.last.mLead + lw.last.mSide)}%.
					The character with the most lines closes the film in {pct(lw.ledByWoman.topCloses, lw.ledByWoman.films)}% of films when she's a woman, and {pct(lw.ledByMan.topCloses, lw.ledByMan.films)}% when he's a man.
				</p>
			</div>

			<div class="two">
				<div>
					<h3>Open on a woman's line</h3>
					<ul class="hbars wide-labels">
						{decadeRows('first').map((r) => (
							<li>
								<div class="hb-row" role="img" aria-label={r.aria}>
									<span class="hb-label">{r.label}</span>
									<span class="hb-track"><span class="hb-bar" style={`width: ${(r.share * 100).toFixed(1)}%`} /></span>
									<span class="hb-value">{r.value}</span>
								</div>
							</li>
						))}
					</ul>
				</div>
				<div>
					<h3>End on a woman's line</h3>
					<ul class="hbars wide-labels">
						{decadeRows('last').map((r) => (
							<li>
								<div class="hb-row" role="img" aria-label={r.aria}>
									<span class="hb-label">{r.label}</span>
									<span class="hb-track"><span class="hb-bar" style={`width: ${(r.share * 100).toFixed(1)}%`} /></span>
									<span class="hb-value">{r.value}</span>
								</div>
							</li>
						))}
					</ul>
				</div>
			</div>

			<h3>Pass or fail</h3>
			<ul class="hbars wide-labels">
				{passRows.map((r) => (
					<li>
						<div class="hb-row" role="img" aria-label={r.aria}>
							<span class="hb-label">{r.label}</span>
							<span class="hb-track"><span class="hb-bar" style={`width: ${(r.share * 100).toFixed(1)}%`} /></span>
							<span class="hb-value">{r.value}</span>
						</div>
					</li>
				))}
			</ul>
			<div class="prose">
				<p>
					Films that pass the test end on a woman's line {pct(lw.pass.w, lw.pass.films)}% of the time, films that fail {pct(lw.fail.w, lw.fail.films)}%.
					{pct(lw.bothMen, lw.films)}% of films open and close on a man, {pct(lw.bothWomen, lw.films)}% on a woman.
				</p>
			</div>

			<h3>Some last words</h3>
			<ul class="quotes">
				{quotes.map((f) => (
					<li class={f.bookends!.last!.gender!}>
						<q>{f.bookends!.last!.text}</q>
						<p class="note">{f.bookends!.last!.name}, {f.bookends!.last!.lead ? 'a lead' : 'side character'}, in <a href={`/films/${f.slug}/`}>{f.title} ({f.year})</a></p>
					</li>
				))}
			</ul>
			<p class="note prose">
				Lines come from each script, which can differ from the film as released. A lead is one of the two characters with the most lines. {n(lw.first.none)} {lw.first.none === 1 ? 'film has' : 'films have'} no clear first line and {n(lw.last.none)} no clear last line, where the script
				opens or ends on credits, songs or stage directions; they're left out of those counts. Old scanned scripts sometimes leave a stage direction in a quote.
			</p>
		</section>

		<section class="section">
			<h2 id="crew-title" class="section-title">Behind the camera</h2>
			<h3>Women in each job</h3>
			<ul class="hbars wide-labels">
				{jobRows.map((r) => (
					<li>
								<div class="hb-row" role="img" aria-label={r.aria}>
						<span class="hb-label">{r.label}</span>
						<span class="hb-track">{r.share > 0 && <span class="hb-bar" style={`width: ${(r.share * 100).toFixed(1)}%`} />}</span>
						<span class="hb-value">{r.value}</span>
						</div>
					</li>
				))}
			</ul>
			<div class="prose">
				<p>
					{directors && `Women directed ${n(directors.w)} of the ${n(directors.w + directors.m + directors.nb)} director credits.`}
					{shooters && shooters.w === 0 && ' None of the films was shot by a woman.'}
					{` Films with a woman director pass ${n(s.womanDirector.yes.pass)} of ${n(s.womanDirector.yes.films)} times (${pct(s.womanDirector.yes.pass, s.womanDirector.yes.films)}%), the rest ${n(s.womanDirector.no.pass)} of ${n(s.womanDirector.no.films)} (${pct(s.womanDirector.no.pass, s.womanDirector.no.films)}%).`}
					{` With a woman among the writers, ${n(s.womanWriter.yes.pass)} of ${n(s.womanWriter.yes.films)} pass (${pct(s.womanWriter.yes.pass, s.womanWriter.yes.films)}%), against ${n(s.womanWriter.no.pass)} of ${n(s.womanWriter.no.films)} (${pct(s.womanWriter.no.pass, s.womanWriter.no.films)}%) without.`}
				</p>
				<p class="note">
					Credits come from TMDB, which lists a gender for almost everyone in these jobs but not for much of the wider crew. A person
					who did a job on several films counts once per film. With only {n(s.womanDirector.yes.films)} films directed by a woman on the
					shelf, that gap could be chance.
				</p>
			</div>
		</section>

		<section class="section">
			<h2 id="directors-title" class="section-title">By director</h2>
			<PeopleRanking people={directorRanking} />
			<p class="note">
				The {directorRanking.length} directors with {MIN_DIRECTOR_FILMS} or more films on the shelf, one square per film. Open a name for
				the films. Co-directors, like Joel and Ethan Coen, each count the film. With this few films each, one film moves a director a long
				way.
			</p>
		</section>

		<section class="section">
			<h2 id="stars-title" class="section-title">By star</h2>
			<div class="two">
				<div>
					<h3>Most often pass</h3>
					<PeopleRanking people={starRanking.slice(0, STAR_LIST)} />
				</div>
				<div>
					<h3>Least often pass</h3>
					<PeopleRanking people={starRanking.slice(-STAR_LIST).reverse()} />
				</div>
			</div>
			<p class="note">
				Of the {starRanking.length} actors billed in the top three of {MIN_STAR_FILMS} or more films on the shelf, {starWomen} are women.
				These are the ten at each end.
			</p>
		</section>

		<section class="section">
			<h2 id="ages-title" class="section-title">How old the stars were</h2>
			<dl class="tiles">
				<div>
					<dt>{Math.round(s.ages.women!)}</dt>
					<dd>the average age of the top-billed women when their film came out.</dd>
				</div>
				<div>
					<dt>{Math.round(s.ages.men!)}</dt>
					<dd>the same for the top-billed men.</dd>
				</div>
				<div>
					<dt>{pct(s.ages.womenYounger, s.ages.films)}%</dt>
					<dd>of films cast women who are younger on average than the men ({n(s.ages.womenYounger)} of {n(s.ages.films)}).</dd>
				</div>
			</dl>
			<p class="note">The ten top-billed actors of each film, from TMDB birthdays, for the {n(s.ages.films)} films with at least one woman and one man among them.</p>
		</section>

		<section class="section">
			<h2 id="money-title" class="section-title">The money</h2>
			<div class="prose">
				<p>
					The median film that passes made {times(s.money.pass.multiple)} its budget at the box office. The median film that fails
					made {times(s.money.fail.multiple)} its budget.
				</p>
				<p class="note">
					Budgets and worldwide box office from TMDB, not adjusted for inflation, for the {n(s.money.pass.films + s.money.fail.films)}
					films that have both numbers.
				</p>
			</div>
		</section>
	</div>
</Base>

<style>
	.film-list {
		columns: 3 12rem;
		padding-left: var(--space-4);
		margin: var(--space-3) 0 var(--space-5);
	}
	.section-lead {
		margin: 0 0 var(--space-5);
	}
	#screen-title ~ h3,
	#screen-title ~ .two h3 {
		margin-top: var(--space-6);
	}
	/* The verdict on screen: one bar per page verdict, split by what it becomes */
	.flows {
		list-style: none;
		padding: 0;
		margin: 0 0 var(--space-3);
		max-width: 760px;
	}
	.flows li + li {
		margin-top: var(--space-4);
	}
	.flow-label {
		margin: 0 0 var(--space-1);
		font-weight: 700;
	}
	.flow-label .note {
		font-weight: 400;
	}
	.flow-bar {
		display: flex;
		gap: 2px;
		height: 1.5rem;
	}
	.flow-part {
		display: block;
		min-width: 3px;
	}
	.flow-part:first-child {
		border-radius: 4px 0 0 4px;
	}
	.flow-part:last-child {
		border-radius: 0 4px 4px 0;
	}
	.flow-part.same,
	.flow-swatch.same {
		background: var(--chalk);
	}
	/* Tangerine is the site's "disputed" color, as on the film pages: pink means passes */
	.flow-part.flip,
	.flow-swatch.flip {
		background: var(--tangerine);
	}
	/* An edge keeps "unclear" from reading as the empty track */
	.flow-part.unclear,
	.flow-swatch.unclear {
		background: var(--plank);
		outline: 1px solid var(--muted);
		outline-offset: -1px;
	}
	.flow-values {
		margin: var(--space-1) 0 0;
		font-variant-numeric: tabular-nums;
	}
	/* How much of the script is heard: ten columns, 0-100% */
	.columns {
		display: flex;
		align-items: flex-end;
		gap: 2px;
		height: 8rem;
		max-width: 480px;
	}
	.column {
		flex: 1 1 0;
		min-height: 2px;
		background: var(--chalk);
		border-radius: 4px 4px 0 0;
	}
	.columns + .axis-ends {
		display: flex;
		justify-content: space-between;
		max-width: 480px;
		margin: var(--space-1) 0 0;
	}
	/* The best-known films whose verdict changes, as a row of tapes */
	.shelf-row {
		margin-bottom: var(--space-3);
	}
	.two {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
		gap: var(--space-5) var(--space-6);
	}
	h3 {
		font-size: clamp(1.5rem, 3vw, 1.875rem);
		margin-bottom: var(--space-3);
	}
	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: var(--space-5);
		margin: 0 0 var(--space-4);
	}
	.tiles dt {
		font-family: var(--poster);
		font-size: clamp(2.75rem, 7vw, 4.5rem);
		line-height: 1;
		color: var(--pink);
	}
	.tiles dd {
		margin: var(--space-2) 0 0;
		max-width: 28ch;
	}
	/* Last words: one bar per end of the film, split by gender and lead or side */
	.stack-rows {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		align-items: center;
		gap: var(--space-3);
		max-width: 960px;
		margin-bottom: var(--space-3);
	}
	.stack-label {
		margin: 0;
	}
	.stack {
		display: flex;
		gap: var(--mark-gap);
		height: 2.5rem;
	}
	.stack-part {
		display: block;
		min-width: 3px;
	}
	/* Filled: a lead. Outlined: a side character */
	.stack-part.w.lead,
	.stack-swatch.w.lead {
		background: var(--pink);
	}
	.stack-part.m.lead,
	.stack-swatch.m.lead {
		background: var(--chalk);
	}
	.stack-part.w.side,
	.stack-swatch.w.side {
		border: 3px solid var(--pink);
	}
	.stack-part.m.side,
	.stack-swatch.m.side {
		border: 3px solid var(--chalk);
	}
	.stack-part.unknown,
	.stack-swatch.unknown {
		background: var(--muted);
	}
	.quotes {
		list-style: none;
		padding: 0;
		margin: 0 0 var(--space-4);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
		gap: var(--space-4) var(--space-6);
	}
	.quotes li {
		border-left: 3px solid var(--muted);
		padding-left: var(--space-3);
		min-width: 0;
	}
	.quotes li.w {
		border-left-color: var(--pink);
	}
	.quotes li.m {
		border-left-color: var(--chalk);
	}
	.quotes q {
		font-size: var(--text-lead);
		overflow-wrap: anywhere;
	}
	@media (max-width: 480px) {
		.stack-rows {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-1);
		}
	}
	.table-view summary {
		/* 44px tall, for a thumb */
		min-height: 44px;
		padding-block: var(--space-2);
		cursor: pointer;
		text-decoration: underline dotted var(--muted);
		text-underline-offset: 0.2em;
		width: fit-content;
	}
	.table-view table {
		margin-top: var(--space-3);
		border-collapse: collapse;
		font-variant-numeric: tabular-nums;
	}
	.table-view th,
	.table-view td {
		padding: var(--space-1) var(--space-4) var(--space-1) 0;
		text-align: right;
	}
	.table-view thead th {
		color: var(--muted);
		font-weight: normal;
	}
</style>
