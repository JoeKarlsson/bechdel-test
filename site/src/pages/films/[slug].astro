		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1) contrast(1.4);
		mix-blend-mode: multiply;
	}
	.hero-text {
		position: relative;
		width: 100%;
		padding-bottom: var(--space-8);
	}
	.verdict-stamp {
		display: inline-block;
		margin: 0 0 var(--space-3);
		font-family: var(--poster);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		line-height: 1;
		text-transform: uppercase;
		background: var(--ink);
		padding: var(--space-2) var(--space-3);
		transform: rotate(-2deg);
	}
	.verdict-stamp.pass {
		color: var(--pink);
	}
	.verdict-stamp.fail {
		color: var(--fail);
	}
	.hero h1 {
		font-size: clamp(3.5rem, 11vw, 10rem);
		line-height: 1.05;
	}
	.hero h1.long {
		font-size: clamp(2.75rem, 7vw, 6.5rem);
	}
	.hero h1 {
		line-height: 1.15;
	}
	.hero h1 span {
		background: var(--ink);
		color: var(--chalk);
		padding: 0 var(--space-4);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}
	.credit {
		display: inline-block;
		margin: var(--space-4) 0 0;
		background: var(--ink);
		padding: var(--space-1) var(--space-3);
	}

	/* The Bechdel test card */
	.bechdel {
		position: relative;
		margin-top: calc(-1 * var(--space-6));
		padding: var(--space-5) clamp(1.25rem, 3vw, 2.75rem) var(--space-6);
		transform: rotate(-0.4deg);
	}
	.bechdel h2 {
		font-size: 2rem;
		margin-bottom: var(--space-5);
	}
	.bechdel-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-6) var(--space-7);
	}
	.score {
		flex: 0 1 300px;
	}
	.score p {
		margin: 0;
	}
	.score-label {
		font-family: var(--poster);
		font-size: 1.375rem;
		text-transform: uppercase;
	}
	.score-n {
		font-family: var(--poster);
		font-size: 10rem;
		line-height: 0.85;
	}
	.score-n span {
		font-size: 4rem;
	}
	.stamp {
		display: inline-block;
		margin-top: var(--space-3) !important;
		font-family: var(--poster);
		font-size: 2.75rem;
		line-height: 1;
		text-transform: uppercase;
		padding: var(--space-1) var(--space-3);
		transform: rotate(-3deg);
	}
	.stamp.pass {
		background: var(--pink);
	}
	.stamp.fail {
		background: var(--fail);
	}
	.rules {
		flex: 1 1 420px;
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}
	.rules li {
		display: grid;
		grid-template-columns: 4rem minmax(0, 1fr);
		gap: var(--space-3);
		align-items: start;
	}
	.rules strong {
		font-family: var(--poster);
		font-weight: 400;
		font-size: 1.625rem;
		text-transform: uppercase;
	}
	.mark {
		font-family: var(--poster);
		font-size: 1.75rem;
		text-transform: uppercase;
		text-align: center;
		background: var(--ink);
		padding: var(--mark-gap) 0;
	}
	.mark.yes {
		color: var(--pink);
	}
	.mark.no {
		color: var(--fail);
	}
	.opinions {
		margin-top: var(--space-6);
		padding-top: var(--space-4);
		border-top: 3px solid var(--ink);
	}
	.opinions h3 {
		font-size: 1.375rem;
		margin-bottom: var(--space-3);
	}
	.opinion-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		gap: var(--space-4) var(--space-6);
	}
	.opinion-grid p {
		margin: 0;
	}
	.tag {
		font-family: var(--poster);
		font-weight: 400;
		font-size: 1.375rem;
		text-transform: uppercase;
		padding: 0 var(--space-2);
	}
	.tag.agree {
		background: var(--pink);
	}
	.tag.disagree {
		background: var(--tangerine);
	}
	.tag.none {
		background: var(--ink);
		color: var(--chalk);
	}

	/* The film */
	.film-info {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-6);
		align-items: flex-start;
	}
	.info-poster {
		flex: 0 0 auto;
		width: 240px;
		height: auto;
	}
	/* On phones the hero already shows the film; the poster only repeats it */
	/* Folding exhibits: open on wide screens, closed on phones (scripts/fold.ts) */
	.fold > summary {
		display: block;
		list-style: none;
		cursor: pointer;
	}
	.fold > summary::-webkit-details-marker {
		display: none;
	}
	.fold > summary h3 {
		display: inline;
	}
	.fold > summary h3::after {
		content: ' +';
		color: var(--pink);
	}
	.fold[open] > summary h3::after {
		content: ' \2212';
	}
	.paper .fold > summary h3::after,
	.flag .fold > summary h3::after {
		color: var(--ink);
	}
	.gist {
		margin: var(--space-2) 0 var(--space-4);
		max-width: 46em;
	}
	.fold-hint {
		display: none;
	}
	:global(html.folded) .fold-hint {
		display: block;
	}

	/* Exhibit: scores against the shelf */
	.shelf-swatch {
		background: var(--plank);
	}
	.ramp-steps {
		display: inline-flex;
		gap: 2px;
	}
	.ramp-steps span {
		width: 0.75rem;
		height: 1rem;
		background: var(--tone);
	}
	.vs-shelf {
		list-style: none;
		padding: 0 !important;
		margin: 0 !important;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
		gap: var(--space-6) var(--space-6);
	}
	.vs-shelf > li + li {
		margin-top: 0;
	}
	.vs-name {
		margin: 0 0 var(--space-2);
		font-family: var(--poster);
		font-size: 1.375rem;
		text-transform: uppercase;
	}
	.hist {
		display: flex;
		align-items: flex-end;
		gap: var(--mark-gap);
		height: 96px;
		padding-bottom: 1.5rem;
		position: relative;
	}
	.hcol {
		flex: 1;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		position: relative;
	}
	.hbar {
		display: block;
		background: var(--plank);
		border-radius: 3px 3px 0 0;
	}
	.hcol.mine .hbar {
		background: var(--tone);
	}
	.hval {
		position: absolute;
		bottom: -1.5rem;
		width: 100%;
		text-align: center;
		font-size: 0.875rem;
		color: var(--muted);
	}
	.hcol.mine .hval {
		color: var(--chalk);
		font-weight: 700;
	}
	.vs-line {
		margin: var(--space-3) 0 0;
	}
	.vs-score {
		font-family: var(--poster);
		font-weight: 400;
		font-size: 1.5rem;
	}

	/* Exhibit: drive or react */
	.tug {
		display: flex;
		gap: var(--mark-gap);
		margin-bottom: var(--space-5);
		font-family: var(--poster);
		font-size: 1.25rem;
		text-transform: uppercase;
	}
	.tug span {
		padding: var(--space-2) var(--space-3);
		white-space: nowrap;
		min-width: 0;
	}
	.tug-drive {
		background: var(--pink);
		color: var(--ink);
	}
	.tug-react {
		background: var(--plank);
		color: var(--chalk);
		text-align: right;
	}

	/* Exhibit: claim against count */
	.claim-count {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: var(--space-4);
		margin-bottom: var(--space-5);
	}
	.claim-count > div {
		padding: var(--space-3) var(--space-4);
	}
	.claim {
		background: var(--chalk);
		outline: 3px solid var(--ink);
	}
	.count {
		background: var(--ink);
		color: var(--chalk);
	}
	.claim-count p {
		margin: 0;
	}
	.cc-label {
		font-family: var(--poster);
		font-size: 1.25rem;
		text-transform: uppercase;
		margin-bottom: var(--space-2) !important;
	}
	.cc-big {
		font-family: var(--poster);
		font-size: 1.75rem;
		line-height: 1.1;
		text-transform: uppercase;
	}
	.pink-on-chalk {
		color: var(--pink);
	}
	.cc-bar {
		display: flex;
		gap: var(--mark-gap);
		height: 16px;
		margin: var(--space-3) 0 var(--space-2);
	}
	.cc-w {
		background: var(--pink);
	}
	.cc-m {
		background: var(--chalk);
	}
	.note-dark {
		color: var(--muted);
		font-size: var(--text-small);
	}

	/* Exhibit: her side, his side as a split screen */
	.side-switch {
		display: none;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
	}
	.side-switch button {
		font-family: var(--poster);
		font-size: 1.25rem;
		text-transform: uppercase;
		background: var(--ink);
		color: var(--chalk);
		border: 2px solid var(--chalk);
		padding: var(--space-2) var(--space-4);
		min-height: 44px;
		cursor: pointer;
	}
	.side-switch button[aria-pressed='true'] {
		background: var(--chalk);
		color: var(--ink);
	}
	.side-switch button[data-side='w'][aria-pressed='true'] {
		background: var(--pink);
		border-color: var(--pink);
	}
	/* Each row is label, women, men in the markup (so phones read it in that
	   order); on wide screens the label sits in the middle column */
	.split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(7rem, auto) minmax(0, 1fr);
		grid-auto-flow: dense;
		gap: var(--space-3) var(--space-4);
		align-items: start;
	}
	.split-head.w,
	.split-cell.w {
		grid-column: 1;
	}
	.split-spine-head,
	.split-label {
		grid-column: 2;
	}
	.split-head.m,
	.split-cell.m {
		grid-column: 3;
	}
	.split p {
		margin: 0;
	}
	.split-head {
		font-family: var(--poster);
		font-size: 1.5rem;
		text-transform: uppercase;
	}
	.split-head.w,
	.split-cell.w {
		text-align: right;
	}
	.split-head.w {
		color: var(--pink);
	}
	.split-cell.w {
		color: var(--pink);
	}
	.split-label {
		text-align: center;
		font-family: var(--poster);
		font-size: 1rem;
		text-transform: uppercase;
		color: var(--muted);
		padding-top: 0.2rem;
		border-left: 2px solid var(--plank);
		border-right: 2px solid var(--plank);
	}

	/* Exhibit: the charge sheet */
	.charges {
		list-style: none;
		padding: 0 !important;
		margin: 0 !important;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.charge {
		background: var(--ink);
		color: var(--chalk);
		padding: var(--space-3) var(--space-4);
	}
	.charge > summary {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas: 'name found' 'sev n';
		gap: var(--space-1) var(--space-3);
		align-items: center;
		cursor: pointer;
		list-style: none;
		min-height: 44px;
	}
	.charge > summary::-webkit-details-marker {
		display: none;
	}
	.charge-name {
		grid-area: name;
		font-family: var(--poster);
		font-size: 1.5rem;
		text-transform: uppercase;
	}
	.charge-name::after {
		content: ' +';
		color: var(--tangerine);
	}
	.charge[open] .charge-name::after {
		content: ' \2212';
	}
	.charge-found {
		grid-area: found;
		font-size: var(--text-small);
	}
	.charge-sev {
		grid-area: sev;
		display: block;
		height: 10px;
		background: var(--plank);
	}
	.charge-sev span {
		display: block;
		height: 100%;
		background: var(--tangerine);
	}
	.charge-n {
		grid-area: n;
		font-family: var(--poster);
		font-size: 1.125rem;
		color: var(--tangerine);
	}
	.charge ul {
		margin-top: var(--space-1);
	}
	.charge p {
		margin: var(--space-2) 0;
	}

	@media (max-width: 600px) {
		.info-poster.has-hero {
			display: none;
		}
	}
	.info-text {
		flex: 999 1 480px;
		min-width: 0;
	}
	.plot {
		max-width: 38em;
		margin: 0;
	}
	.facts {
		margin: var(--space-5) 0 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
		gap: var(--space-4) var(--space-5);
	}
	.facts dt {
		font-family: var(--poster);
		font-size: 1.125rem;
		text-transform: uppercase;
		color: var(--muted);
	}
	.facts dd {
		margin: 0;
	}

	/* Starring */
	.starring {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-1) var(--space-5);
		font-family: var(--poster);
		line-height: 1;
		text-transform: uppercase;
	}
	.star {
		/* --size runs 0 to 1 by share of lines; the top size shrinks with the screen */
		font-size: calc(1.375rem + var(--size) * clamp(1.5rem, 11vw, 7.4rem));
		overflow-wrap: anywhere;
	}
	.star.w {
		color: var(--pink);
	}
	.star.m {
		color: var(--chalk);
	}
	.star.unknown {
		color: var(--muted);
	}
	.star-n {
		font-family: var(--book);
		font-size: 1rem;
		color: var(--chalk);
		margin-left: var(--space-1);
		vertical-align: super;
	}
	.cast {
		margin-top: var(--space-5);
	}
	/* The two plain dropdowns: the full cast and the timeline's numbers */
	.cast > summary,
	.data-table > summary {
		font-family: var(--poster);
		font-size: 1.375rem;
		text-transform: uppercase;
		color: var(--pink);
		cursor: pointer;
		min-height: 44px;
		display: flex;
		align-items: center;
	}
	.cast ul {
		margin: var(--space-3) 0 0;
		padding: 0;
		list-style: none;
		columns: 3 240px;
		column-gap: var(--space-6);
		font-size: var(--text-small);
	}
	.cast li {
		margin-bottom: var(--space-2);
		break-inside: avoid;
	}
	.cast li.woman {
		color: var(--pink);
	}

	/* Timeline */
	.chart-note {
		margin-bottom: var(--space-6);
		max-width: 48em;
	}
	.axis-label {
		margin: 0;
		font-family: var(--poster);
		font-size: 1.25rem;
		text-transform: uppercase;
	}
	.axis-label.women {
		color: var(--pink);
		margin-bottom: var(--space-2);
	}
	.axis-label.men {
		margin-top: var(--space-2);
	}
	.timeline {
		display: flex;
		gap: var(--mark-gap);
		position: relative;
	}
	/* The baseline between women's bars above and men's below */
	.timeline::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 50%;
		height: 2px;
		margin-top: -1px;
		background: var(--muted);
		pointer-events: none;
	}
	.col {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}
	.col:focus-visible {
		outline-offset: 1px;
	}
	.col[aria-pressed='true'] .bar,
	.col:hover .bar {
		filter: brightness(1.25);
	}
	.col[aria-pressed='true'] {
		outline: 2px solid var(--chalk);
		outline-offset: -2px;
	}
	.half {
		display: flex;
		height: 180px;
	}
	.half.up {
		align-items: flex-end;
		padding-bottom: 1px;
	}
	.half.down {
		align-items: flex-start;
		padding-top: 1px;
	}
	.bar {
		display: block;
		width: 100%;
	}
	.bar.w {
		background: var(--pink);
		border-radius: 3px 3px 0 0;
	}
	.bar.m {
		background: var(--chalk);
		border-radius: 0 0 3px 3px;
	}
	.axis-ends {
		display: flex;
		justify-content: space-between;
		margin-top: var(--space-2);
	}
	.readout {
		margin-top: var(--space-4);
		min-height: 6.5rem;
		padding: var(--space-3) var(--space-4);
		background: var(--panel);
	}
	.readout :global(p) {
		margin: 0;
	}
	.readout :global(.readout-title) {
		font-family: var(--poster);
		font-size: 1.5rem;
		text-transform: uppercase;
	}
	.readout :global(.w) {
		color: var(--pink);
	}
	.data-table {
		margin-top: var(--space-4);
	}
	.data-table table {
		border-collapse: collapse;
		font-size: var(--text-small);
		margin-top: var(--space-3);
	}
	.data-table th,
	.data-table td {
		padding: var(--space-1) var(--space-4) var(--space-1) 0;
		text-align: left;
	}

	/* The evidence wall */
	.evidence-title {
		font-size: clamp(3rem, 6vw, 4rem);
	}
	.paper-swatch {
		background: var(--chalk);
	}
	.panel-swatch {
		background: var(--panel);
		outline: 1px solid var(--muted);
	}
	.flag-swatch {
		background: var(--tangerine);
	}
	.wall {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-7) var(--space-5);
		align-items: flex-start;
		margin-top: var(--space-6);
	}
	.exhibit {
		position: relative;
		/* Let wide content (the comparison table) scroll inside instead of
		   stretching the panel past the screen */
		min-width: 0;
		padding: var(--space-6) clamp(1.25rem, 3vw, 2.25rem) var(--space-5);
	}
	.exhibit h3 {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		margin-bottom: var(--space-4);
	}
	.exhibit h4 {
		font-size: 1.375rem;
		margin-bottom: var(--space-2);
	}
	.exhibit ul,
	.exhibit ol {
		margin: 0 0 var(--space-3);
		padding-left: var(--space-4);
	}
	.exhibit li + li {
		margin-top: var(--space-1);
	}
	.wide {
		flex: 2 1 560px;
	}
	.narrow {
		flex: 1 1 300px;
	}
	.full {
		flex: 1 1 100%;
	}
	.tilt-l {
		transform: rotate(-0.8deg);
	}
	.tilt-r {
		transform: rotate(0.8deg);
	}
	.panel {
		background: var(--panel);
	}
	.flag {
		background: var(--tangerine);
		color: var(--ink);
	}
	.tape-strip {
		position: absolute;
		top: -14px;
		left: 40%;
		width: 110px;
		height: 28px;
		background: var(--pink);
		transform: rotate(3deg);
	}
	.flag .tape-strip {
		background: var(--chalk);
	}
	.script {
		margin: 0 0 var(--space-5);
	}
	.script blockquote {
		margin: 0;
		white-space: pre-line;
		/* Scripts have long unbroken runs (dashes, run-together words) */
		overflow-wrap: anywhere;
		font-size: 1.125rem;
	}
	.script dl {
		margin: var(--space-4) 0 0;
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		gap: var(--space-2) var(--space-3);
		font-size: var(--text-small);
	}
	.script dt {
		font-weight: 700;
	}
	.script dd {
		margin: 0;
		overflow-wrap: anywhere; /* topics like "wedding/relationship" */
	}
	.waffle {
		display: grid;
		grid-template-columns: repeat(10, minmax(0, 1fr));
		gap: var(--mark-gap);
		max-width: 340px;
		margin-bottom: var(--space-3);
	}
	.cell {
		aspect-ratio: 1;
	}
	.cell.w,
	.sq.w {
		background: var(--pink);
	}
	.cell.m,
	.sq.m {
		background: var(--chalk);
	}
	.squares {
		display: flex;
		flex-wrap: wrap;
		gap: var(--mark-gap);
		margin: var(--space-1) 0 var(--space-3);
	}
	.sq {
		width: 16px;
		height: 16px;
	}
	.sq.unknown {
		background: var(--muted);
	}
	/* Non-binary: an outlined square, always named in words beside it */
	.sq.nb,
