										<div class="squares">
											{Array.from({ length: bechdel.womenChars ?? 0 }, () => <span class="sq w" />)}
											{Array.from({ length: bechdel.menChars ?? 0 }, () => <span class="sq m" />)}
										</div>
										<p class="note">With lines</p>
										<div class="squares">
											{Array.from({ length: bechdel.womenSpeaking ?? 0 }, () => <span class="sq w" />)}
											{Array.from({ length: bechdel.menSpeaking ?? 0 }, () => <span class="sq m" />)}
										</div>
									</div>
									<ul class="legend small">
										<li><span class="swatch swatch-w" />Women</li>
										<li><span class="swatch swatch-m" />Men</li>
									</ul>
								</details>
							</section>
						)}

						{has.heard && m && (
							<section class="exhibit panel wide tilt-r" aria-labelledby="ex-heard">
								<details class="fold" open data-fold>
									<summary>
										<h3 id="ex-heard">Exhibit {letter('heard')}: who gets heard</h3>
										<p class="gist">
											{m.firstWomanLine === null
												? 'No woman speaks.'
												: m.firstWomanLine === 1
													? 'A woman speaks the first line.'
													: `The first woman speaks at line ${m.firstWomanLine.toLocaleString('en-US')} of ${film.dialogueCount.toLocaleString('en-US')}.`}
											{` The longest stretch with no woman speaking runs ${plural(m.longestWithoutWoman, 'line')}.`}
										</p>
									</summary>
									<p class="note">Every line of dialogue, first to last</p>
									<div
										class="strip"
										role="img"
										aria-label={`${film.dialogueCount} lines of dialogue. ${m.firstWomanLine === null ? 'No woman speaks.' : `The first woman speaks at line ${m.firstWomanLine}.`} The longest stretch with no woman speaking is ${m.longestWithoutWoman} lines${m.longestWithoutWomanStart ? `, from line ${m.longestWithoutWomanStart}` : ''}.`}
									>
										{m.longestWithoutWomanStart && (
											<span class="stretch" style={`left: ${at(m.longestWithoutWomanStart)}; width: ${((m.longestWithoutWoman / film.dialogueCount) * 100).toFixed(2)}%`} />
										)}
										{m.firstWomanLine !== null && <span class="first" style={`left: ${at(m.firstWomanLine)}`} />}
									</div>
									<ul class="legend small">
										{m.firstWomanLine !== null && <li><span class="swatch swatch-w" />First line by a woman</li>}
										<li><span class="swatch swatch-m" />Longest stretch with no woman speaking</li>
									</ul>
									{womenWordShare !== null && (
										<>
											<p class="note">Words spoken</p>
											<div class="share-bar" role="img" aria-label={`Women speak ${womenWordShare}% of the words, men ${100 - womenWordShare}%`}>
												<span class="part w" style={`flex-grow: ${m.words.w}`} />
												<span class="part m" style={`flex-grow: ${m.words.m}`} />
											</div>
											<p>
												Women speak {womenWordShare}% of the words ({m.words.w.toLocaleString('en-US')}), men {100 - womenWordShare}% ({m.words.m.toLocaleString('en-US')}).
												{womenShare !== null && womenWordShare !== womenShare && ` Women have ${womenShare}% of the lines, so their lines run ${womenWordShare > womenShare ? 'longer' : 'shorter'} than men's.`}
											</p>
										</>
									)}
								</details>
							</section>
						)}

						{has.reverse && m && (
							<section class="exhibit panel narrow tilt-l" aria-labelledby="ex-reverse">
								<details class="fold" open data-fold>
									<summary>
										<h3 id="ex-reverse">Exhibit {letter('reverse')}: the test the other way</h3>
										<p class="gist">
											{m.reverseScore === 3
												? 'Two named men talk to each other about something besides a woman. It passes the reverse test.'
												: `Run the other way, for men, the film scores ${m.reverseScore} out of 3.`}
										</p>
									</summary>
									<p class="note">Conversations between two named characters</p>
									<div class="pairs" role="img" aria-label={`Women talk with each other ${plural(m.womenConversations, 'time')}; men talk with each other ${plural(m.menConversations, 'time')}.`}>
										<p class="pair-label">Two women</p>
										<span class="pair-bar w" style={`width: ${((m.womenConversations / conversationMax) * 100).toFixed(1)}%`} />
										<p class="pair-n">{m.womenConversations}</p>
										<p class="pair-label">Two men</p>
										<span class="pair-bar m" style={`width: ${((m.menConversations / conversationMax) * 100).toFixed(1)}%`} />
										<p class="pair-n">{m.menConversations}</p>
									</div>
								</details>
							</section>
						)}

						{has.crew && crew && (
							<section class="exhibit panel full tilt-r" aria-labelledby="ex-crew">
								<details class="fold" open data-fold>
									<summary>
										<h3 id="ex-crew">Exhibit {letter('crew')}: behind the camera</h3>
										<p class="gist">
											{`${crew.keyWomen === 0 ? 'None' : crew.keyWomen} of the ${crew.keyPeople} people in these jobs ${crew.keyWomen === 1 ? 'is a woman' : 'are women'}.`}
											{crewWomenShare !== null && ` Across the whole crew, ${crewWomenShare}% of the people whose gender is listed are women.`}
										</p>
									</summary>
									<div class="crew">
										<dl class="roles">
											{crew.roles.map((g) => (
												<>
													<dt>{g.label}</dt>
													<dd>
														{g.people.slice(0, SHOWN_PER_JOB).map((p, i) => (
															<span class="person"><span class:list={['sq', p.gender ?? 'unknown']} aria-hidden="true" />{p.name}<span class="sr-only">{p.gender ? ` (${genderWord[p.gender]})` : ' (gender not listed)'}</span>{p.gender === 'nb' && <span class="note"> (non-binary)</span>}{i < Math.min(g.people.length, SHOWN_PER_JOB) - 1 && ', '}</span>
														))}
														{g.people.length > SHOWN_PER_JOB && <span class="note">{` and ${g.people.length - SHOWN_PER_JOB} more`}</span>}
													</dd>
												</>
											))}
										</dl>
										<div>
											<p class="note">The crew, department by department</p>
											<ul class="depts">
												{departments.map((d) => (
													<li>
														<p class="dept-name">{d.name === 'Crew' ? 'Other crew' : d.name}</p>
														<div
															class="share-bar"
															role="img"
															aria-label={`${d.name}: ${plural(d.w, 'woman', 'women')}, ${plural(d.m, 'man', 'men')}${d.nb ? `, ${d.nb} non-binary` : ''}, ${d.unknown} not listed`}
														>
															{d.w > 0 && <span class="part w" style={`flex-grow: ${d.w}`} />}
															{d.m > 0 && <span class="part m" style={`flex-grow: ${d.m}`} />}
															{d.nb > 0 && <span class="part nb" style={`flex-grow: ${d.nb}`} />}
															{d.unknown > 0 && <span class="part unknown" style={`flex-grow: ${d.unknown}`} />}
														</div>
														<p class="dept-n note">{d.w} women, {d.m} men{d.nb ? `, ${d.nb} non-binary` : ''}{d.unknown ? `, ${d.unknown} not listed` : ''}</p>
													</li>
												))}
											</ul>
										</div>
									</div>
									<ul class="legend small">
										<li><span class="swatch swatch-w" />Women</li>
										<li><span class="swatch swatch-m" />Men</li>
										{crew.all.nb > 0 && <li><span class="swatch swatch-nb" />Non-binary</li>}
										<li><span class="swatch swatch-unknown" />Gender not listed on TMDB</li>
									</ul>
								</details>
							</section>
						)}

						{has.ages && (
							<section class="exhibit panel wide tilt-l" aria-labelledby="ex-ages">
								<details class="fold" open data-fold>
									<summary>
										<h3 id="ex-ages">Exhibit {letter('ages')}: how old the stars were</h3>
										<p class="gist">
											{ageRows.map((r) => `${r.label}: ${mean(r.people.map((p) => p.age))} on average.`).join(' ')}
											{' '}The top-billed cast, at the film's release.
										</p>
									</summary>
									{ageRows.map((r) => (
										<div class="age-row">
											<p class="age-label">{r.label}</p>
											<div class="age-line" role="img" aria-label={`${r.label}: ${r.people.map((p) => `${p.actor}, ${p.age}`).join('; ')}`}>
												{r.people.map((p) => <span class:list={['dot', r.key]} style={`left: ${((p.age / ageMax) * 100).toFixed(1)}%`} />)}
											</div>
											<p class="note">{r.people.map((p) => `${p.actor} ${p.age}`).join(', ')}</p>
										</div>
									))}
									<div class="axis-ends note" aria-hidden="true"><span>0</span><span>{ageMax}</span></div>
								</details>
							</section>
						)}

						{has.money && money && (
							<section class="exhibit panel narrow tilt-r" aria-labelledby="ex-money">
								<details class="fold" open data-fold>
									<summary>
										<h3 id="ex-money">Exhibit {letter('money')}: the money</h3>
										<p class="gist">
											{multiple !== null
												? `It made ${multiple >= 1 ? `${multiple.toFixed(1)} times` : `${Math.round(multiple * 100)}% of`} what it cost.`
												: 'What it cost and made, where TMDB lists it.'}
										</p>
									</summary>
									<dl class="stats">
										<dt>Budget</dt>
										<dd>{money.budget ? dollars(money.budget) : 'Not listed'}</dd>
										<dt>Box office</dt>
										<dd>{money.revenue ? dollars(money.revenue) : 'Not listed'}</dd>
									</dl>
									<p class="note">From TMDB, not adjusted for inflation.</p>
								</details>
							</section>
						)}

						{has.scores && (
							<section class="exhibit panel full tilt-r" aria-labelledby="ex-scores">
								<details class="fold" open data-fold>
									<summary>
										<h3 id="ex-scores">Exhibit {letter('scores')}: how the film treats women, against the shelf</h3>
										<p class="gist">The AI's five scores, turned so higher is always better for women, next to every film we've checked.</p>
									</summary>
									<ul class="legend small">
										<li><span class="swatch shelf-swatch" />Other films on the shelf</li>
										<li><span class="ramp-steps" aria-hidden="true"><span style="--t: 0" /><span style="--t: 0.33" /><span style="--t: 0.66" /><span style="--t: 1" /></span>{film.title}, gray for worse, pink for better</li>
										<li class="note">Tap a name for what it means</li>
									</ul>
									<ul class="vs-shelf">
										{scoreRows.map((s) => (
											<li>
												<p class="vs-name"><Term term={s.term}>{s.name}</Term></p>
												<div class="hist" role="img" aria-label={`${s.name}: ${film.title} scores ${s.mine} out of 10. ${s.sentence}`}>
													{s.counts.map((n, v) => (
														<span class:list={['hcol', { mine: v === s.mine }]} style={v === s.mine ? `--t: ${v / 10}` : undefined}>
															<span class="hbar" style={`height: ${n === 0 ? 0 : Math.max(8, (n / s.max) * 100)}%`} />
															<span class="hval">{v}</span>
														</span>
													))}
												</div>
												<p class="vs-line">
													<strong class="vs-score">{s.mine}/10</strong> {s.sentence}
													<span class="note"> The AI's own number: {DIMENSIONS.find((d) => d.key === s.key)!.flip ? `${s.name.replace('Free of ', '').replace(/^./, (c) => c.toUpperCase())} ${s.raw}/10, where higher is worse` : `${s.raw}/10`}.</span>
												</p>
											</li>
										))}
									</ul>
								</details>
							</section>
						)}

						{has.agency && ai && (
							<section class="exhibit panel full tilt-l" aria-labelledby="ex-agency">
								<details class="fold" open data-fold>
									<summary>
										<h3 id="ex-agency">Exhibit {letter('agency')}: do the women drive the story?</h3>
										<p class="gist">Agency is whether women's choices move the story, or the story happens to them. The AI found {plural(ai.agency.drives.length, 'moment')} where they drive it and {ai.agency.reacts.length} where they react.</p>
									</summary>
									<div class="tug" role="img" aria-label={`${ai.agency.drives.length} moments driving the story, ${ai.agency.reacts.length} reacting`}>
										<span class="tug-drive" style={`flex: ${Math.max(ai.agency.drives.length, 0.2)}`}>Drive {ai.agency.drives.length}</span>
										<span class="tug-react" style={`flex: ${Math.max(ai.agency.reacts.length, 0.2)}`}>React {ai.agency.reacts.length}</span>
									</div>
									<div class="three">
										{ai.agency.drives.length > 0 && (
											<div>
												<h4 class="pink">They drive it</h4>
												<ul>{ai.agency.drives.map((t) => <li>{t}</li>)}</ul>
											</div>
										)}
										{ai.agency.reacts.length > 0 && (
											<div>
												<h4>They react</h4>
												<ul>{ai.agency.reacts.map((t) => <li>{t}</li>)}</ul>
											</div>
										)}
										{(ai.agency.decisions || ai.agency.goals) && (
											<div>
												<h4>How they decide</h4>
												{ai.agency.decisions && <p>{ai.agency.decisions}.</p>}
												{ai.agency.goals && <p>Goals: {ai.agency.goals}.</p>}
											</div>
										)}
									</div>
								</details>
							</section>
						)}

						{has.power && ai && (
							<section class="exhibit paper wide tilt-r" aria-labelledby="ex-power">
								<span class="tape-strip" aria-hidden="true" />
								<details class="fold" open data-fold>
									<summary>
										<h3 id="ex-power">Exhibit {letter('power')}: who holds the power</h3>
										<p class="gist">Who gives orders, who gets interrupted, who holds the official roles. Where we can count it, the count sits next to the AI's claim.</p>
									</summary>
									{ai.power.speakingTime && womenShare !== null && (
										<div class="claim-count">
											<div class="claim">
												<p class="cc-label">The AI says</p>
												<p>"{ai.power.speakingTime}."</p>
											</div>
											<div class="count">
												<p class="cc-label">The count says</p>
												<p class="cc-big"><span class="pink-on-chalk">{womenShare}%</span> of lines are women's</p>
												<div class="cc-bar" role="img" aria-label={`Women ${lines?.w} lines, men ${lines?.m}`}>
													<span class="cc-w" style={`flex: ${lines?.w}`} />
													<span class="cc-m" style={`flex: ${lines?.m}`} />
												</div>
												<p class="note-dark">{lines?.w} lines to {lines?.m}</p>
											</div>
										</div>
									)}
									<dl class="stack">
										{ai.power.interruptions.length > 0 && <div><dt>Interrupting</dt><dd>{ai.power.interruptions.join('. ')}.</dd></div>}
										{ai.power.questions && <div><dt>Questions and commands</dt><dd>{ai.power.questions}.</dd></div>}
										{ai.power.authority.length > 0 && <div><dt>Authority</dt><dd>{ai.power.authority.join('. ')}.</dd></div>}
										{ai.power.speakingTime && womenShare === null && <div><dt>Speaking time</dt><dd>{ai.power.speakingTime}.</dd></div>}
									</dl>
								</details>
							</section>
						)}

						{has.compare && ai && (
							<section class="exhibit panel full tilt-l" aria-labelledby="ex-compare">
								<details class="fold" open data-fold>
									<summary>
										<h3 id="ex-compare">Exhibit {letter('compare')}: her side, his side</h3>
										<p class="gist">How the AI describes the women and the men in this film, row by row.</p>
									</summary>
									<div class="side-switch" role="group" aria-label="Show" hidden data-side-switch>
										<button type="button" aria-pressed="true" data-side="w">Her side</button>
										<button type="button" aria-pressed="false" data-side="m">His side</button>
									</div>
									<div class="split" data-split>
										<p class="split-head w">Women</p>
										<p class="split-spine-head" aria-hidden="true" />
										<p class="split-head m">Men</p>
										{ai.compare.map(([k, w, m]) => (
											<>
												<p class="split-label">{k}</p>
												<p class="split-cell w">{w ?? 'Not noted'}</p>
												<p class="split-cell m">{m ?? 'Not noted'}</p>
											</>
										))}
									</div>
									{ai.archetypes.length > 0 && (
										<p class="note">Archetypes: {ai.archetypes.map((a) => `${a.name}, ${a.kind.toLowerCase()}`).join('; ')}.</p>
									)}
									{ai.compareNotes.map((n) => <p class="note">{n}.</p>)}
								</details>
							</section>
						)}

						{has.flags && (
							<section class="exhibit flag full tilt-r" aria-labelledby="ex-flags">
								<span class="tape-strip" aria-hidden="true" />
								<details class="fold" open data-fold>
									<summary>
										<h3 id="ex-flags">Exhibit {letter('flags')}: what the AI flagged</h3>
										<p class="gist">Problems the AI found, worst first. Open one for the details.</p>
									</summary>
									<ul class="charges">
										{flagGroups.map((g) => (
											<li>
												<details class="charge">
													<summary>
														<span class="charge-name">{g.name}</span>
														<span class="charge-found">{g.found} found</span>
														{g.severity !== null && (
															<span class="charge-sev" role="img" aria-label={`Severity ${g.severity} out of 10`}>
																<span style={`width: ${g.severity * 10}%`} />
															</span>
														)}
														{g.severity !== null && <span class="charge-n">{g.severity}/10</span>}
													</summary>
													{g.lists.map(([label, items]) => (
														<>
															<p class="group">{label === 'Microaggressions' ? <Term term="microaggression" id={`micro-${film.slug}`}>Microaggressions</Term> : label}</p>
															<ul>{items.map((t) => <li>{t}</li>)}</ul>
														</>
													))}
													{g.notes.map(([label, text]) => (
														<p><strong>{label === 'Tokenism' ? <Term term="tokenism" id={`tokenism-${film.slug}`}>Tokenism</Term> : label}:</strong> {text}.</p>
													))}
												</details>
											</li>
										))}
									</ul>
								</details>
							</section>
						)}

						{has.recs && ai && (
							<section class="exhibit paper full tilt-l" aria-labelledby="ex-recs">
								<span class="tape-strip" aria-hidden="true" />
								<details class="fold" open data-fold>
									<summary>
										<h3 id="ex-recs">Exhibit {letter('recs')}: what the AI would change</h3>
										<p class="gist">The AI's suggestions for making this story better for women.</p>
									</summary>
									<ol class="recs">
										{ai.recommendations.map((r) => (
											<li><strong>{r.area}:</strong> {r.text}.</li>
										))}
									</ol>
								</details>
							</section>
						)}
					</div>
				</section>
			)
		}

		<section class="section about" aria-labelledby="how-title">
			<h2 id="how-title" class="section-title">About this analysis</h2>
			<p>
				Our parser read the script{film.sceneCount > 0 && `: ${film.sceneCount} scenes and ${film.dialogueCount.toLocaleString('en-US')} lines of dialogue`}.
				{ai && ` ${ai.model.maker}'s ${ai.model.name} read the same script${analyzed ? ` on ${analyzed}` : ''}.`}
				{readers && ' The bechdeltest.com rating comes from that site’s readers.'}
				{' '}<a href="/about/">How the test works</a>
			</p>
		</section>

		<section class="section" aria-labelledby="more-title">
			<h2 id="more-title" class="section-title">Related films</h2>
			<ul class="related">
				{related.map((f) => <Tape film={f} />)}
			</ul>
			<p class="back"><a href="/">Back to the whole shelf</a></p>
		</section>

		<div class="share-row">
			<ShareLinks url={pageUrl} title={`${film.title} ${bechdel.pass ? 'passes' : 'fails'} the Bechdel test`} />
		</div>
	</div>
</Base>

<script>
	import { setUpTimeline } from '../../scripts/timeline';
	import { setUpExhibits } from '../../scripts/exhibits';
	setUpTimeline();
	setUpExhibits();
</script>

<style>
	/* Hero: the backdrop in pink duotone, verdict and title on top */
	.hero {
		position: relative;
		background: var(--pink);
		overflow: hidden;
		min-height: clamp(320px, 46vw, 580px);
		display: flex;
		align-items: flex-end;
	}
	.hero.no-image {
		min-height: 0;
		padding-top: var(--space-8);
	}
