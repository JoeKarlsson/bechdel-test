---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import Tape from '../../components/Tape.astro';
import { loadFilms } from '../../lib/films.mjs';
import { posterFor, backdropFor } from '../../lib/images';

export function getStaticPaths() {
	return loadFilms().map((film) => ({ params: { slug: film.slug }, props: { film } }));
}

const { film } = Astro.props;
// Six films with the same verdict, nearest in popularity: somewhere to go next
const related = loadFilms()
	.filter((f) => f.id !== film.id && f.bechdel.pass === film.bechdel.pass)
	.sort((a, b) => Math.abs(a.popularity - film.popularity) - Math.abs(b.popularity - film.popularity))
	.slice(0, 6);
const pageUrl = `https://bechdel.joekarlsson.com/films/${film.slug}/`;
const { bechdel, readers, ai } = film;
const poster = posterFor(film.id);
const backdrop = backdropFor(film.id);
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const yes = (ok: boolean) => (ok ? 'Yes' : 'No');

// What each rule's yes or no rests on, in plain words
const ruleEvidence = [
	bechdel.rules[0]
		? // Only quote the counts when they back the result (some exports have none)
			(bechdel.womenChars ?? 0) >= 2 && bechdel.womenSpeaking !== null
			? `${plural(bechdel.womenChars, 'woman character', 'women characters')}. ${bechdel.womenSpeaking} of them speak.`
			: 'The film has at least two women characters.'
		: 'Fewer than two women characters.',
	bechdel.rules[1]
		? bechdel.pass
			? `In ${plural(bechdel.scenesPass, 'scene')} out of ${bechdel.scenesTotal}.`
			: 'Women do talk to each other.'
		: 'Our parser found no scene where two women talk to each other.',
	bechdel.rules[2]
		? `In ${bechdel.scenesPass === 1 ? 'that scene' : 'those scenes'}, our script parser found no man named.`
		: bechdel.rules[1]
			? 'Every conversation between women that our parser found mentions a man.'
			: 'Not reached: the film fails an earlier rule.',
];
const ruleNames = ['At least two women', 'Who talk to each other', 'About something besides a man'];

// Second opinions
const readersAgree = readers ? (readers.score === 3) === bechdel.pass : null;
const review = ai?.review && ai.review.scenes.length ? ai.review : null;
const confidences = review?.scenes.map((s) => s.confidence).filter((c): c is number => c !== null) ?? [];
const confidence = confidences.length ? Math.round((confidences.reduce((a, b) => a + b, 0) / confidences.length) * 100) : null;
const aiAgrees = review ? review.pass === bechdel.pass : null;

// The AI's five scores, turned so a longer bar is always better for women
const scoreRows = ai
	? [
			['Agency', ai.scores.agency, false],
			['Free of stereotypes', ai.scores.stereotyping, true],
			['Free of bias', ai.scores.bias, true],
			['Diversity', ai.scores.diversity, false],
			['Power balance', ai.scores.power, false],
		]
			.filter(([, v]) => v !== null)
			.map(([name, raw, flip]) => ({
				name: name as string,
				good: flip ? 10 - (raw as number) : (raw as number),
				raw: `${(name as string).replace('Free of stereotypes', 'Stereotyping').replace('Free of bias', 'Bias')} ${raw}/10`,
			}))
	: [];

// Dialogue
const lines = film.lines;
const linesTotal = lines ? lines.w + lines.m + lines.unknown : 0;
const womenShare = lines && lines.w + lines.m > 0 ? Math.round((lines.w / (lines.w + lines.m)) * 100) : null;
const unknownShare = lines ? Math.round((lines.unknown / linesTotal) * 100) : 0;
const topSpeakers = film.speakers.slice(0, 10);
const maxLines = topSpeakers[0]?.lines ?? 1;
const timelineMax = Math.max(1, ...film.timeline.map((b) => Math.max(b.w, b.m)));

// Exhibits only appear when the film has the data; letters follow what's shown
const has = {
	scene: bechdel.passingScenes.length > 0,
	waffle: womenShare !== null,
	cast: bechdel.womenChars !== null && bechdel.menChars !== null,
	scores: scoreRows.length > 0,
	agency: !!ai && (ai.agency.drives.length > 0 || ai.agency.reacts.length > 0 || !!ai.agency.decisions),
	power: !!ai && (ai.power.interruptions.length > 0 || !!ai.power.questions || !!ai.power.speakingTime || ai.power.authority.length > 0),
	compare: !!ai && ai.compare.length > 0,
	flags: !!ai && (ai.flags.stereotypes.found.length > 0 || ai.flags.bias.found.length > 0 || ai.flags.diversity.gaps.length > 0),
	recs: !!ai && ai.recommendations.length > 0,
};
const order = Object.entries(has).filter(([, v]) => v).map(([k]) => k);
const letter = (key: string) => String.fromCharCode(65 + order.indexOf(key));

const waffle = womenShare !== null ? Array.from({ length: 100 }, (_, i) => i < womenShare) : [];
const verdictWord = bechdel.pass ? 'Passes' : 'Fails';
// Under 160 characters: long titles drop the second sentence
const verdictSentence = `${film.title} (${film.year}) ${bechdel.pass ? 'passes' : 'fails'} the Bechdel test with a score of ${bechdel.score} out of 3.`;
const descriptionTail = ' See who talks, scene by scene, and what an AI found in the script.';
const description = verdictSentence.length + descriptionTail.length <= 160 ? verdictSentence + descriptionTail : verdictSentence;
const analyzed = ai?.analyzedAt ? new Date(ai.analyzedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : null;
const facts = [
	['Released', film.released],
	['Genres', film.genres.join(', ') || null],
	['Rated', film.rated],
	['IMDb', film.imdbRating !== null ? `${film.imdbRating} / 10` : null],
	['Metascore', film.metascore !== null ? `${film.metascore} / 100` : null],
	['Awards', film.awards.join('; ') || null],
].filter(([, v]) => v);
const credit = [
	film.year,
	film.directors.length ? `Directed by ${film.directors.join(' and ')}` : null,
	film.writers.length ? `written by ${film.writers.join(' and ')}` : null,
]
	.filter(Boolean)
	.join('. ')
	.replace('. written', ', written');
---

<Base
	title={`${film.title} (${film.year}): ${verdictWord.toLowerCase()} the Bechdel test`}
	description={description}
	image={`/og/${film.slug}.jpg`}
	imageAlt={`${film.title}: ${verdictWord.toLowerCase()} the Bechdel test, score ${bechdel.score} out of 3`}
	structuredData={{
		'@type': 'Movie',
		name: film.title,
		datePublished: film.year ? String(film.year) : undefined,
		director: film.directors.map((name: string) => ({ '@type': 'Person', name })),
		url: `https://bechdel.joekarlsson.com/films/${film.slug}/`,
	}}
>
	<section class:list={['hero', { 'no-image': !backdrop }]}>
		{
			backdrop && (
				<Picture src={backdrop} alt="" widths={[640, 1280]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="hero-image" />
			)
		}
		<div class="hero-text page">
			<p class:list={['verdict-stamp', bechdel.pass ? 'pass' : 'fail']}>{verdictWord} the Bechdel test</p>
			<h1 class:list={{ long: film.title.length > 22 }}><span>{film.title}</span></h1>
			{credit && <p class="credit">{credit}.</p>}
		</div>
	</section>

	<div class="page">
		<section class="bechdel paper" aria-labelledby="bt-title">
			<h2 id="bt-title">The Bechdel test</h2>
			<div class="bechdel-row">
				<div class="score">
					<p class="score-label">Bechdel score</p>
					<p class="score-n">{bechdel.score}<span> / 3</span></p>
					<p class:list={['stamp', bechdel.pass ? 'pass' : 'fail']}>{verdictWord}</p>
				</div>
				<ol class="rules">
					{
						ruleNames.map((name, i) => (
							<li>
								<span class:list={['mark', bechdel.rules[i] ? 'yes' : 'no']}>{yes(bechdel.rules[i])}</span>
								<span>
									<strong>
										{i + 1}. {name}
									</strong>
									<br />
									{ruleEvidence[i]}
									{i === 2 && has.scene && (
										<>
											{' '}
											<a href="#exhibit-scene">See the scene</a>.
										</>
									)}
								</span>
							</li>
						))
					}
				</ol>
			</div>
			<div class="opinions">
				<h3>Second opinions</h3>
				<div class="opinion-grid">
					<p>
						{
							readers ? (
								<>
									<strong class:list={['tag', readersAgree ? 'agree' : 'disagree']}>{readersAgree ? 'Agree' : 'Disagree'}</strong>{' '}
									<a href={readers.id ? `https://bechdeltest.com/view/${readers.id}/` : 'https://bechdeltest.com/'} rel="noopener noreferrer" target="_blank">
										bechdeltest.com readers
									</a>{' '}
									give it {readers.score} out of 3{readers.dubious ? ', though someone marked that rating as dubious.' : '.'}
								</>
							) : (
								<>
									<strong class="tag none">Not rated</strong> bechdeltest.com readers haven't rated this film.
								</>
							)
						}
					</p>
					<p>
						{
							review ? (
								<>
									<strong class:list={['tag', aiAgrees ? 'agree' : 'disagree']}>{aiAgrees ? 'Agree' : 'Disagree'}</strong> An AI re-read the
									{review.scenes.length === 1 ? ' passing scene' : ` ${review.scenes.length} passing scenes`} and scores the film {review.score ?? 0} out of 3
									{review.reasoning ? <>: "{review.reasoning.replace(/\.?$/, '.')}"</> : '.'}
									{confidence !== null && <> It's {confidence}% sure.</>}
								</>
							) : (
								<>
									<strong class="tag none">Not reviewed</strong> The AI only re-checks scenes our parser passes, so it had nothing to review here.
								</>
							)
						}
					</p>
				</div>
			</div>
		</section>

		<div class="share-row">
			<ShareLinks url={pageUrl} title={`${film.title} ${bechdel.pass ? 'passes' : 'fails'} the Bechdel test`} />
		</div>

		<section class="section film-info" aria-labelledby="film-title">
			{
				poster && (
					<Picture src={poster} alt={`Poster for ${film.title}`} widths={[240, 480]} sizes="240px" formats={['avif', 'webp']} loading="lazy" decoding="async" class="info-poster" />
				)
			}
			<div class="info-text">
				<h2 id="film-title" class="section-title">The film</h2>
				{film.plot && <p class="plot">{film.plot}</p>}
				<dl class="facts">
					{
						facts.map(([k, v]) => (
							<div>
								<dt>{k}</dt>
								<dd>{v}</dd>
							</div>
						))
					}
					{
						film.imdbUrl && (
							<div>
								<dt>Elsewhere</dt>
								<dd>
									<a href={film.imdbUrl} rel="noopener noreferrer" target="_blank">
										View on IMDb
									</a>
								</dd>
							</div>
						)
					}
				</dl>
			</div>
		</section>

		{
			topSpeakers.length > 0 && (
				<section class="section" aria-labelledby="starring-title">
					<h2 id="starring-title" class="section-title">
						Starring, by lines spoken
					</h2>
					<ul class="legend">
						<li><span class="swatch swatch-w" />Women</li>
						<li><span class="swatch swatch-m" />Men</li>
						<li><span class="swatch swatch-unknown" />Not in the cast list</li>
						<li class="note">Bigger name, more lines</li>
					</ul>
					<ol class="starring">
						{topSpeakers.map((s) => (
							<li class:list={['star', s.gender ?? 'unknown']} style={`--size: ${Math.sqrt(s.lines / maxLines).toFixed(3)}`}>
								{s.name}
								<span class="star-n">
									{s.lines}
									<span class="sr-only"> lines{s.gender === 'w' ? ', woman' : s.gender === 'm' ? ', man' : ''}</span>
								</span>
							</li>
						))}
					</ol>
				</section>
			)
		}
		{
			film.cast.length > 0 && (
				<details class="cast">
					<summary>Full cast, {film.cast.length} {film.cast.length === 1 ? 'person' : 'people'}</summary>
					<ul>
						{film.cast.map((c) => (
							<li class:list={{ woman: c.gender === 'w' }}>
								{c.actor} {c.role && <span class="note">as {c.role}</span>}
							</li>
						))}
					</ul>
				</details>
			)
		}

		{
			film.timeline.length > 0 ? (
				<section class="section" aria-labelledby="timeline-title">
					<h2 id="timeline-title" class="section-title">
						Who talks, scene by scene
					</h2>
					<p class="note chart-note">
						Lines of dialogue in every {plural(film.timeline[0].to - film.timeline[0].from + 1, 'scene')}, start to finish. Women above the line, men below.
						{unknownShare > 0 && ` ${unknownShare}% of lines come from characters we couldn't match to the cast list and aren't shown.`}
					</p>
					<div class="timeline">
						<span class="axis-label top">Women</span>
						<span class="axis-label bottom">Men</span>
						<div class="bars" role="img" aria-label={`Lines by women and men across ${film.sceneCount} scenes. Women ${lines?.w ?? 0} lines, men ${lines?.m ?? 0}.`}>
							<div class="half up">
								{film.timeline.map((b) => (
									<span class="bar w" style={`height: ${((b.w / timelineMax) * 100).toFixed(1)}%`} title={`Scenes ${b.from} to ${b.to}: women ${b.w} lines, men ${b.m}`} />
								))}
							</div>
							<div class="baseline" />
							<div class="half down">
								{film.timeline.map((b) => (
									<span class="bar m" style={`height: ${((b.m / timelineMax) * 100).toFixed(1)}%`} title={`Scenes ${b.from} to ${b.to}: women ${b.w} lines, men ${b.m}`} />
								))}
							</div>
						</div>
					</div>
					<p class="note axis-ends">
						<span>Scene 1</span>
						<span>Scene {film.sceneCount}</span>
					</p>
					<details class="data-table">
						<summary>Show the numbers</summary>
						<table>
							<thead>
								<tr><th scope="col">Scenes</th><th scope="col">Women's lines</th><th scope="col">Men's lines</th></tr>
							</thead>
							<tbody>
								{film.timeline.map((b) => (
									<tr><td>{b.from} to {b.to}</td><td>{b.w}</td><td>{b.m}</td></tr>
								))}
							</tbody>
						</table>
					</details>
				</section>
			) : (
				<section class="section" aria-labelledby="timeline-title">
					<h2 id="timeline-title" class="section-title">
						Who talks, scene by scene
					</h2>
					<p>We couldn't read who says what in this film's script, so there's no dialogue chart for it yet.</p>
				</section>
			)
		}

		{
			order.length > 0 && (
				<section class="section" aria-labelledby="evidence-title">
					<h2 id="evidence-title" class="section-title evidence-title">The evidence</h2>
					<ul class="legend">
						<li><span class="swatch paper-swatch" />Straight from the script</li>
						<li><span class="swatch panel-swatch" />Counted from the script, or the AI's read of it</li>
						<li><span class="swatch flag-swatch" />Problems the AI flagged</li>
					</ul>

					<div class="wall">
						{has.scene && (
							<section id="exhibit-scene" class="exhibit paper wide tilt-l" aria-labelledby="ex-scene">
								<span class="tape-strip" aria-hidden="true" />
								<h3 id="ex-scene">Exhibit {letter('scene')}: {bechdel.passingScenes.length === 1 ? 'the passing scene' : 'the passing scenes'}</h3>
								{bechdel.passingScenes.map((scene, i) => (
									<figure class="script">
										<blockquote>{scene.trim()}</blockquote>
										{review?.scenes[i] && (
											<figcaption>
												<dl>
													{review.scenes[i].women.length > 0 && (
														<>
															<dt>Women in it</dt>
															<dd>{review.scenes[i].women.join(', ')}</dd>
														</>
													)}
													{review.scenes[i].subject && review.scenes[i].subject !== 'None' && (
														<>
															<dt>Talking about</dt>
															<dd>{review.scenes[i].subject}</dd>
														</>
													)}
													{review.scenes[i].reasoning && (
														<>
															<dt>The AI says</dt>
															<dd>
																"{review.scenes[i].reasoning}"
																{review.scenes[i].result && ` ${review.scenes[i].result === 'pass' ? 'Passes' : 'Fails'}`}
																{review.scenes[i].confidence !== null && `, ${Math.round(review.scenes[i].confidence * 100)}% sure`}.
															</dd>
														</>
													)}
												</dl>
											</figcaption>
										)}
									</figure>
								))}
							</section>
						)}

						{has.waffle && (
							<section class="exhibit panel narrow tilt-r" aria-labelledby="ex-waffle">
								<h3 id="ex-waffle">Exhibit {letter('waffle')}: every 100 lines</h3>
								<div class="waffle" role="img" aria-label={`${womenShare} of every 100 lines are spoken by women`}>
									{waffle.map((w) => <span class:list={['cell', w ? 'w' : 'm']} />)}
								</div>
								<p>
									{womenShare} spoken by women, {100 - (womenShare ?? 0)} by men: {lines?.w} lines to {lines?.m}.
								</p>
								<ul class="legend small">
									<li><span class="swatch swatch-w" />Women</li>
									<li><span class="swatch swatch-m" />Men</li>
								</ul>
							</section>
						)}

						{has.cast && (
							<section class="exhibit panel narrow tilt-l" aria-labelledby="ex-cast">
								<h3 id="ex-cast">Exhibit {letter('cast')}: who's in it</h3>
								<div role="img" aria-label={`Characters: ${bechdel.womenChars} women and ${bechdel.menChars} men. With lines: ${bechdel.womenSpeaking} women and ${bechdel.menSpeaking} men.`}>
									<p class="note">Characters</p>
									<div class="squares">
										{Array.from({ length: bechdel.womenChars ?? 0 }, () => <span class="sq w" />)}
										{Array.from({ length: bechdel.menChars ?? 0 }, () => <span class="sq m" />)}
									</div>
									<p class="note">With lines</p>
									<div class="squares">
										{Array.from({ length: bechdel.womenSpeaking ?? 0 }, () => <span class="sq w" />)}
										{Array.from({ length: bechdel.menSpeaking ?? 0 }, () => <span class="sq m" />)}
									</div>
								</div>
								<p>
									{plural(bechdel.womenChars ?? 0, 'woman', 'women')} and {plural(bechdel.menChars ?? 0, 'man', 'men')}. {bechdel.womenSpeaking} women and {bechdel.menSpeaking} men have lines.
								</p>
							</section>
						)}

						{has.scores && (
							<section class="exhibit panel wide tilt-r" aria-labelledby="ex-scores">
								<h3 id="ex-scores">Exhibit {letter('scores')}: how the film treats women</h3>
								<p class="note">The AI's five scores, turned so a longer bar is always better for women. Its raw score is on the right.</p>
								<ul class="score-bars">
									{scoreRows.map((s) => (
										<li>
											<span class="sb-name">{s.name}</span>
											<span class="sb-track" role="img" aria-label={`${s.name}: ${s.good} out of 10`}>
												<span class="sb-bar" style={`width: ${s.good * 10}%`} />
											</span>
											<span class="note">{s.raw}</span>
										</li>
									))}
								</ul>
							</section>
						)}

						{has.agency && ai && (
							<section class="exhibit panel full tilt-l" aria-labelledby="ex-agency">
								<h3 id="ex-agency">Exhibit {letter('agency')}: do the women drive the story?</h3>
								{ai.scores.agency !== null && <p class="note">The AI's agency score: {ai.scores.agency} out of 10.</p>}
								<div class="three">
									{ai.agency.drives.length > 0 && (
										<div>
											<h4 class="pink">They drive it</h4>
											<ul>{ai.agency.drives.map((t) => <li>{t}</li>)}</ul>
										</div>
									)}
									{ai.agency.reacts.length > 0 && (
										<div>
											<h4>They react</h4>
											<ul>{ai.agency.reacts.map((t) => <li>{t}</li>)}</ul>
										</div>
									)}
									{(ai.agency.decisions || ai.agency.goals) && (
										<div>
											<h4>How they decide</h4>
											{ai.agency.decisions && <p>{ai.agency.decisions}.</p>}
											{ai.agency.goals && <p>Goals: {ai.agency.goals}.</p>}
										</div>
									)}
								</div>
							</section>
						)}

						{has.power && ai && (
							<section class="exhibit paper narrow tilt-r" aria-labelledby="ex-power">
								<span class="tape-strip" aria-hidden="true" />
								<h3 id="ex-power">Exhibit {letter('power')}: who holds the power</h3>
								{ai.scores.power !== null && <p class="power-score">Power balance {ai.scores.power} / 10</p>}
								<dl class="stack">
									{ai.power.interruptions.length > 0 && (
										<div><dt>Interrupting</dt><dd>{ai.power.interruptions.join('. ')}.</dd></div>
									)}
									{ai.power.questions && (
										<div><dt>Questions and commands</dt><dd>{ai.power.questions}.</dd></div>
									)}
									{ai.power.speakingTime && (
										<div>
											<dt>Speaking time</dt>
											<dd>
												{ai.power.speakingTime}.
												{womenShare !== null && ` The line count says women have ${womenShare}% of the lines.`}
											</dd>
										</div>
									)}
									{ai.power.authority.length > 0 && (
										<div><dt>Authority</dt><dd>{ai.power.authority.join('. ')}.</dd></div>
									)}
								</dl>
								<p class="source">The AI's read</p>
							</section>
						)}

						{has.compare && ai && (
							<section class="exhibit panel wide tilt-l" aria-labelledby="ex-compare">
								<h3 id="ex-compare">Exhibit {letter('compare')}: her side, his side</h3>
								<div class="table-scroll" tabindex="0" role="region" aria-label="Women and men compared; scrolls sideways">
									<table class="compare">
										<thead>
											<tr><th scope="col"><span class="sr-only">Aspect</span></th><th scope="col" class="pink">Women</th><th scope="col">Men</th></tr>
										</thead>
										<tbody>
											{ai.compare.map(([k, w, m]) => (
												<tr><th scope="row">{k}</th><td>{w ?? 'Not noted'}</td><td>{m ?? 'Not noted'}</td></tr>
											))}
										</tbody>
									</table>
								</div>
								{ai.archetypes.length > 0 && (
									<p class="note">Archetypes: {ai.archetypes.map((a) => `${a.name}, ${a.kind.toLowerCase()}`).join('; ')}.</p>
								)}
								{ai.compareNotes.map((n) => <p class="note">{n}.</p>)}
							</section>
						)}

						{has.flags && ai && (
							<section class="exhibit flag full tilt-r" aria-labelledby="ex-flags">
								<span class="tape-strip" aria-hidden="true" />
								<h3 id="ex-flags">Exhibit {letter('flags')}: what the AI flagged</h3>
								<div class="three">
									{ai.flags.stereotypes.found.length > 0 && (
										<div>
											<h4>Stereotypes{ai.scores.stereotyping !== null && `, ${ai.scores.stereotyping}/10`}</h4>
											<p class="group">Found</p>
											<ul>{ai.flags.stereotypes.found.map((t) => <li>{t}</li>)}</ul>
											{ai.flags.stereotypes.patterns.length > 0 && (
												<>
													<p class="group">Patterns</p>
													<ul>{ai.flags.stereotypes.patterns.map((t) => <li>{t}</li>)}</ul>
												</>
											)}
										</div>
									)}
									{ai.flags.bias.found.length > 0 && (
										<div>
											<h4>Bias{ai.scores.bias !== null && `, ${ai.scores.bias}/10`}</h4>
											<p class="group">Found</p>
											<ul>{ai.flags.bias.found.map((t) => <li>{t}</li>)}</ul>
											{ai.flags.bias.patterns.length > 0 && (
												<>
													<p class="group">Patterns</p>
													<ul>{ai.flags.bias.patterns.map((t) => <li>{t}</li>)}</ul>
												</>
											)}
											{ai.flags.bias.microaggressions.length > 0 && (
												<>
													<p class="group">Microaggressions</p>
													<ul>{ai.flags.bias.microaggressions.map((t) => <li>{t}</li>)}</ul>
												</>
											)}
											{ai.flags.bias.systemic && <p><strong>Overall:</strong> {ai.flags.bias.systemic}.</p>}
										</div>
									)}
									{ai.flags.diversity.gaps.length > 0 && (
										<div>
											<h4>Diversity{ai.scores.diversity !== null && `, ${ai.scores.diversity}/10`}</h4>
											<p class="group">Who's missing</p>
											<ul>{ai.flags.diversity.gaps.map((t) => <li>{t}</li>)}</ul>
											{ai.flags.diversity.identity && <p>{ai.flags.diversity.identity}.</p>}
											{ai.flags.diversity.tokenism && <p><strong>Tokenism:</strong> {ai.flags.diversity.tokenism}.</p>}
										</div>
									)}
								</div>
							</section>
						)}

						{has.recs && ai && (
							<section class="exhibit paper full tilt-l" aria-labelledby="ex-recs">
								<span class="tape-strip" aria-hidden="true" />
								<h3 id="ex-recs">Exhibit {letter('recs')}: what the AI would change</h3>
								<ol class="recs">
									{ai.recommendations.map((r) => (
										<li><strong>{r.area}:</strong> {r.text}.</li>
									))}
								</ol>
							</section>
						)}
					</div>
				</section>
			)
		}

		<section class="section about" aria-labelledby="how-title">
			<h2 id="how-title" class="section-title">About this analysis</h2>
			<p>
				Our parser read the script{film.sceneCount > 0 && `: ${film.sceneCount} scenes and ${film.dialogueCount.toLocaleString('en-US')} lines of dialogue`}.
				{ai && (analyzed ? ` An AI read the same script on ${analyzed}.` : ' An AI read the same script.')}
				{readers && ' The bechdeltest.com rating comes from that site’s readers.'}
				{' '}<a href="/about/">How the test works</a>
			</p>
		</section>

		<section class="section" aria-labelledby="more-title">
			<h2 id="more-title" class="section-title">More {bechdel.pass ? 'films that pass' : 'films that fail'}</h2>
			<ul class="related">
				{related.map((f) => <Tape film={f} />)}
			</ul>
			<p class="back"><a href="/">Back to the whole shelf</a></p>
		</section>
	</div>
</Base>

