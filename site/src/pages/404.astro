---
import Base from '../layouts/Base.astro';
---

<Base title="Not on the shelf" description="That page isn't on the shelf." noindex notFound>
	<div class="page">
		<h1 class="page-title">Not on the shelf</h1>
		<p class="stamp" aria-hidden="true">Fail</p>
		<p class="page-lead">We couldn't find that page. It may have moved when the site was rebuilt.</p>
		<p class="suggest" data-suggest>Did you mean <a href="/"></a>?</p>
		<p class="links">
			<a href="/">Browse all the films</a>
			<a href="/about/">Read about the test</a>
		</p>
	</div>
</Base>

<script>
	// A mistyped address gets the nearest page: a film for /films/mad-max-fury-rood-2015/
	// (or no year), one of the site's pages for /abuot/
	import { closest } from '../lib/search.mjs';

	const PAGES = [
		{ href: '/about/', title: 'About' },
		{ href: '/numbers/', title: 'The numbers' },
		{ href: '/case-study/', title: 'The case study' },
		{ href: '/privacy/', title: 'Privacy' },
		{ href: '/films/', title: 'Every film, A to Z' },
	];
	const suggest = document.querySelector<HTMLElement>('[data-suggest]')!;
	const offer = (href: string, text: string) => {
		const link = suggest.querySelector('a')!;
		link.href = href;
		link.textContent = text;
		suggest.classList.add('found');
	};

	const slug = location.pathname.match(/^\/films\/([^/]+)/)?.[1];
	if (slug) {
		fetch('/shelf.json')
			.then((res) => (res.ok ? (res.json() as Promise<{ slug: string; title: string; year: number | null }[]>) : []))
			.then((films) => {
				const near = closest(slug, films, (f) => [f.slug, f.slug.replace(/-\d{4}$/, '')]);
				if (near) offer(`/films/${near.slug}/`, near.year ? `${near.title} (${near.year})` : near.title);
			})
			.catch((error) => console.warn('No suggestion for this address:', error)); // the links below still work
	} else {
		const first = location.pathname.split('/').filter(Boolean)[0] ?? '';
		const near = closest(first, PAGES, (p) => [p.href.replaceAll('/', '')]);
		if (near) offer(near.href, near.title);
	}
</script>

<style>
	/* The gray FAIL label from the favicon and the film pages */
	.stamp {
		display: inline-block;
		margin: var(--space-2) 0 var(--space-4);
		font-family: var(--poster);
		font-size: 2.75rem;
		line-height: 1;
		text-transform: uppercase;
		color: var(--ink);
		background: var(--fail);
		padding: var(--space-1) var(--space-3);
		transform: rotate(-3deg);
	}
	/* The line is held from the start, so the links don't jump when a
	   suggestion arrives after the films load */
	.suggest {
		margin-top: var(--space-4);
		font-size: var(--text-lead);
	}
	.suggest:not(.found) {
		visibility: hidden;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-5);
		margin-top: var(--space-6);
		font-size: var(--text-lead);
	}
</style>
