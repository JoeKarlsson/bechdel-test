    "bookends": {
      "first": {
        "speaker": 36,
        "line": 1,
        "text": "Do you know why they suddenly decided to send me home?"
      },
      "last": {
        "speaker": 0,
        "line": 395,
        "text": "To the right, and stop. Now the same but the opposite: backward, backward, to the left and stop. It's simple, you see. No matter where you go, you'll always end up exactly where you started out. One, two, to the right, and stop. Back, two, to the left, and stop."
      }
