    "bookends": {
      "first": {
        "speaker": 0,
        "line": 2,
        "text": "“I telegraphed and phoned. I sent an air mail special too. Your answer was goodbye and there was even postage due. I fell in love just once, and it had to be with you.” Triple rhyme. “Everything happens to me.”"
      },
      "last": {
        "speaker": 0,
        "line": 869,
        "text": "Jack Robbins, formerly Rabinowitz-- he had his name circumcised-- over at MGM, he hears the song; he calls us into his office, he lowers his pastrami, says: “Dick, I love the melody. Strong as anything you’ve ever written. But Larry those words! They’re too artsy- fartsy!"
      }
