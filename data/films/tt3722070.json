    "bookends": {
      "first": {
        "speaker": 1,
        "line": 1,
        "text": "The smell is sweet, with urine only a minor component, the prevalent odour suggesting the inside of someone's ear. Dank clothes are there too, wet wool and onions, which she eats raw, plus what for me has always been the essence of poverty, damp newspaper."
      },
      "last": {
        "speaker": 20,
        "line": 536,
        "text": "Now I’m here I think you should stop talking to yourself."
      }
