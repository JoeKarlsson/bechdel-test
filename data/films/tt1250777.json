    "bookends": {
      "first": {
        "speaker": 0,
        "line": 3,
        "text": "I always wondered why nobody did it before me. I mean, all those comic books. Movies. TV shows... You’d think that one eccentric loner would have made himself a costume."
      },
      "last": {
        "speaker": 3,
        "line": 835,
        "text": "A world full of superheroes, huh? As a great man once said: “wait ‘til they get a load of me”."
      }
    },
