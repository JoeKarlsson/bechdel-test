    "bookends": {
      "first": {
        "speaker": 0,
        "line": 1,
        "text": "You kill your film several times, mostly by talking about it. A film is a dream. You kill it writing it down, you kill it with a camera; the film might come to life for a moment or two when your actors breathe life back into it - but then it dies again, buried in film cans."
      },
      "last": {
        "speaker": 8,
        "line": 754,
        "text": "Alora. Silencio per favore. Silence please. Gyriamo. E alora motore! p. 93"
      }
