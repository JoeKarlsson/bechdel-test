    "bookends": {
      "first": {
        "speaker": 0,
        "line": 2,
        "text": "Now I know what you're thinking. Oh no! Thor's in a cage. How did this happen? Well, sometimes you have to get captured just to get a straight answer out of somebody. It's a long story but basically I'm a bit of a hero."
      },
      "last": {
        "speaker": 0,
        "line": 988,
        "text": "Probably not. But don't worry, brother... I've got a feeling that everything's going to work out."
      }
