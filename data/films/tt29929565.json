    "bookends": {
      "first": {
        "speaker": 0,
        "line": 2,
        "text": "The thing I find interesting about Tamra. The thing... the thing I find most interesting about Tamra. The thing I find most interesting..."
      },
      "last": {
        "speaker": 28,
        "line": 588,
        "text": "We're joined today by the one and only Ariel Ecton. Her debut book came out this morning — but unless you're living on Mars you already know that. Ms. Ecton, how does it feel to write the book everyone is talking about?"
      }
