    "bookends": {
      "first": {
        "speaker": 0,
        "line": 1,
        "text": "To some guys, women are like a cheap puzzle... with pieces that just don't fit. They think the soul of a woman is darker than a back alley... more tangled than a telephone cord... and colder than a Klondike Bar in Canada. But those guys don't even have a clue."
      },
      "last": {
        "speaker": 0,
        "line": 842,
        "text": "No. But if you hum a few bars... I'll fake it."
      }
