    "bookends": {
      "first": {
        "speaker": 0,
        "line": 2,
        "text": "I can't say I even know what the world is anymore. I don't know what happened to it. I don't even know where it is now, I don't know where its centre is, if it even has a centre . All I know is that its dirty people have crawled out here somehow. I don't know why."
      },
      "last": {
        "speaker": 3,
        "line": 511,
        "text": "What did you do to him!?"
      }
