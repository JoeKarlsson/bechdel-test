    "bookends": {
      "first": {
        "speaker": 2,
        "line": 1,
        "text": "Cardinal Nino de Guevara-painted by El Greco around 1596. El Greco is of the Spanish school-although he was really a Greek. That is what El Greco means - \"The Greek.\" El Greco cared nothing for the charms of the flesh -."
      },
      "last": {
        "speaker": 1,
        "line": 1106,
        "text": "I love you, Eben. No matter if we're apart, we'll always be together."
      }
    },
