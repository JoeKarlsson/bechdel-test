    "bookends": {
      "first": {
        "speaker": 1,
        "line": 3,
        "text": "Die! You devil! Die! I was unhappy before but this is a nightmare! ...Where are you, Kang-woo? You’re still here ‘cuz you’re worried about me, aren’t you? I realize now, how much you cared for me....I didn’t mean for it to be like this...."
      },
      "last": {
        "speaker": 1,
        "line": 317,
        "text": "When we die, it’s the end. It’s been fun, father."
      }
