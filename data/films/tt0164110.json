    "bookends": {
      "first": {
        "speaker": 60,
        "line": 2,
        "text": "Only six more hours before the end of curfew. Want to buy us a drink, Indian boy?"
      },
      "last": {
        "speaker": 0,
        "line": 641,
        "text": "I think of the young man from New York, driving home. I think if his voyage were to happen today, he might find a community in Johnson City better equipped to accept him. I have faith in the town and its people. I remember the acts of human kindness that illumine our world."
      }
