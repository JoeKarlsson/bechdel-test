    "bookends": {
      "first": {
        "speaker": 17,
        "line": 2,
        "text": "I'm blowin' out of here, blowin' for good. I'm kissin' it all goodbye, these four stinkin' walls, the six flights up, the el that roars by at three A. M. like a castiron wind. Kiss 'em goodbye for me, Maury! I'll miss 'em – like hell I will!"
      },
      "last": {
        "speaker": 18,
        "line": 783,
        "text": "Don't be silly."
      }
