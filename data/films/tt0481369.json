    "bookends": {
      "first": {
        "speaker": 0,
        "line": 2,
        "text": "\"You can call me Fingerling. It's not my real name, but comes from a book I read as a child, 'Fingerling at the Zoo.' Paper flap long gone, it had a green, hardback cover and mottled texture, and was possibly my very first book."
      },
      "last": {
        "speaker": 2,
        "line": 789,
        "text": "Nothing, mom. It's nothing. Ned walks off."
      }
