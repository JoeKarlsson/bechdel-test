    "bookends": {
      "first": {
        "speaker": 1,
        "line": 1,
        "text": "New York in the summer's like any other tropical port -- Saigon, Rangoon, Hong Kong. It swelters and moves, and sometimes I think there outta be palm trees growing along the sidewalks -- they fit right in with the whores and the hustlers."
      },
      "last": {
        "speaker": 1,
        "line": 776,
        "text": "And the goddamest thing happened. I started to cry."
