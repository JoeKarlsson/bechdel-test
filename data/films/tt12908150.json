    "bookends": {
      "first": {
        "speaker": 22,
        "line": 1,
        "text": "“The past and present wilt; I have filled them, emptied them, and proceed to fill my next fold of the future.”"
      },
      "last": {
        "speaker": 1,
        "line": 632,
        "text": "and I will insist he wasn’t, and I will live my life until my life runs out. I am wonderful, I deserve to be wonderful... and I contain multitudes."
      }
