    "bookends": {
      "first": {
        "speaker": 8,
        "line": 3,
        "text": "Well would he guess the ascending of the star, Wherein his patient's fortunes settled were. He knew the course of every malady, Were it of cold or heat or moist or dry. Brother John, would-be Doctour of Physick."
      },
      "last": {
        "speaker": 18,
        "line": 702,
        "text": "Whether the Earth exists or not, whether we end up in Heaven, or Hell, or the cold vacuum of space, she has."
      }
