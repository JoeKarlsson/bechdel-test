    "bookends": {
      "first": {
        "speaker": 0,
        "line": 1,
        "text": "In a spirit of complete honesty, I want to say right from the start that I think we've made some really incredible mistakes about God. We tell ourselves that He's all-powerful, when we really should be questioning His competence. Believe me, I'm not asking for miracles."
      },
      "last": {
        "speaker": 0,
        "line": 700,
        "text": "What? You'd miss me?"
      }
