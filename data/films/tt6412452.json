    "bookends": {
      "first": {
        "speaker": 3,
        "line": 1,
        "text": "A song never fails to divert m’mind during a long day’s ride out here in the West, where distances’re great and the scenery monotonous. Additionally, m’pleasing baritone seems t’inspirit good ol’ Dan, keepin’ him in good heart through the day’s measure of hoofclops."
      },
      "last": {
        "speaker": 11,
        "line": 652,
        "text": "Hyah!"
      }
