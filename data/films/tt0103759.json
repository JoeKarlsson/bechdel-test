    "bookends": {
      "first": {
        "speaker": 0,
        "line": 2,
        "text": "How many times are you gonna miss the bus? Huh? All the other kids can get up in the morning, but you guys wanna be driven around like the fucking President. I'm your goddamn chauffeur!"
      },
      "last": {
        "speaker": 0,
        "line": 315,
        "text": "If you think you're not getting on this bus, you're dead wrong. No fucking way are you gonna miss this bus, man! You were probably the kind of kids who had your father drive you to school cause you couldn't catch the fucking bus. But no more, man."
      }
