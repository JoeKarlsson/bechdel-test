    "bookends": {
      "first": {
        "speaker": 11,
        "line": 3,
        "text": "Hello little girl... Little Dido. I am your father. Silence. Then a tear rises to the surface and as her confused tears spill, so too do LINDSAY'S."
      },
      "last": {
        "speaker": 0,
        "line": 816,
        "text": "It is not. It is not all that is before you Mr Davinier... I love you... for all that you are, and with all.. all that I am."
      }
    },
