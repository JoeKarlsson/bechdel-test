    "bookends": {
      "first": {
        "speaker": 0,
        "line": 1,
        "text": "...My husband used to tell me I have an overactive imagination. I can’t help it. I mean, haven’t you ever been on a train and wondered about the lives of the people who live near the tracks?"
      },
      "last": {
        "speaker": 0,
        "line": 732,
        "text": "Today, I sit in a different car. And I look ahead. Anything is possible. Because I am not the girl I used to be."
      }
