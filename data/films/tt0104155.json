    "bookends": {
      "first": {
        "speaker": 5,
        "line": 1,
        "text": "Back in the first times, in the time of the red light, the wind, Soo-oop-wa, was a man like us until by mischance he grew wings and flew like a bird."
      },
      "last": {
        "speaker": 5,
        "line": 603,
        "text": "We must struggle to breathe the wind a while longer, to preserve the stories and the memories. To teach the children to read the stony secrets of the hills and listen for the distant singing of the stars."
      }
    },
