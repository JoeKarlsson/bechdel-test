    "bookends": {
      "first": {
        "speaker": 6,
        "line": 2,
        "text": "Greetings, my friend. You are interested in the unknown, the mysterious, the unexplainable... that is why you are here. So now, for the first time, we are bringing you the full story of what happened..."
      },
      "last": {
        "speaker": 6,
        "line": 1232,
        "text": "My friend, you have just seen the story of Edward D. Wood, Junior. Stranger than fact... and yet every incident based on sworn testimony. A man. A life. Can you prove it didn't happen?"
      }
    },
