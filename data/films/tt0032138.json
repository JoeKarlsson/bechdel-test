    "bookends": {
      "first": {
        "speaker": 0,
        "line": 1,
        "text": "She isn't coming yet, Toto. Did she hurt you? She tried to, didn't she? Come on - - we'll go tell Uncle Henry and Auntie Em. Come on, Toto."
      },
      "last": {
        "speaker": 0,
        "line": 1108,
        "text": "Home! And this is my room -- and you're all here! And I'm not going to leave here ever, ever again, because I love you all! And -- Oh, Auntie Em -- there's no place like home!"
      }
