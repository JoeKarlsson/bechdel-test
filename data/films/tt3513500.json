    "bookends": {
      "first": {
        "speaker": 7,
        "line": 3,
        "text": "Hollywood. Tinseltown. Screenland. Glitzburg. The Big Celluloid. You know all the names. Everyone in this town is desperate for something..."
      },
      "last": {
        "speaker": 1,
        "line": 770,
        "text": "They weren't really that compelling characters to begin with. Better to just leave some things as nostalgia and move on with our lives."
      }
    },
