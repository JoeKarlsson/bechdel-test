    "bookends": {
      "first": {
        "speaker": 0,
        "line": 1,
        "text": "I have decided to keep a journal. Not in a word program or a digital file, but in longhand, writing every word out so that every inflection of penmanship is recorded, every word chosen, scratched out, revised to set down all my thoughts..."
      },
      "last": {
        "speaker": 4,
        "line": 516,
        "text": "“What have I to dread, what have I to fear, Leaning on the everlasting arms? I have blessed peace with my Lord so near, Leaning on the everlasting arms.”"
      }
