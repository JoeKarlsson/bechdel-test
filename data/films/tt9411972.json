    "bookends": {
      "first": {
        "speaker": 0,
        "line": 1,
        "text": "The marsh is not a swamp. The marsh is a space of light, where grass grows in water and water flows into the sky."
      },
      "last": {
        "speaker": 0,
        "line": 742,
        "text": "Keep my secrets deep. And you, my love, can walk back home peaceful. As long as you are here, remembering the best of me, you've never lost me. So you'll walk, past our lagoon, under our canopy."
      }
