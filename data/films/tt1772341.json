    "bookends": {
      "first": {
        "speaker": 0,
        "line": 1,
        "text": "My name’s Ralph, and I’m a Bad Guy. I’m 9 feet tall. I weigh 643 pounds. Got a little bit of a temper on me. You know, my passions bubble very near the surface, not gonna lie."
      },
      "last": {
        "speaker": 0,
        "line": 1090,
        "text": "Turns out, I don’t need a medal to tell me I’m a good guy. ‘Cause if that little kid likes me, how bad can I be?"
      }
