    "bookends": {
      "first": {
        "speaker": 22,
        "line": 2,
        "text": "The first castles were the walled cities of Mesopotamia built over 8,000 years ago. Castles haven't changed much down the centuries. There have always been walls ..."
      },
      "last": {
        "speaker": 2,
        "line": 861,
        "text": "On the contrary, Captain. They saved mine. Irwin's eyes cloud over and he's gone."
      }
