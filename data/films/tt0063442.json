    "bookends": {
      "first": {
        "speaker": 17,
        "line": 3,
        "text": "So ends my last signal until we reach our destination. We are now on automatic, a mere hundred and five light years from our base ... and at the mercy of com- puters. I've tucked in my crew for the long sleep. I'll join them presently."
      },
