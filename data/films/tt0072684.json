    "bookends": {
      "first": {
        "speaker": 0,
        "line": 1,
        "text": "My father, who was well-known to the best circles in this kingdom under the name of roaring Harry James, was killed in a duel, when I was fifteen years old."
      },
      "last": {
        "speaker": 17,
        "line": 786,
        "text": "His mother attained a prodigious old age, and the inhabitants of the place in her time can record, with accuracy, the daily disputes which used to take place between mother and son, until the latter, from habits of intoxication, falling into a state of almost imbecility, was…"
      }
