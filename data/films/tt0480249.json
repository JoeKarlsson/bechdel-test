    "bookends": {
      "first": {
        "speaker": 0,
        "line": 2,
        "text": "My name is Robert Neville. Today is October 17th, the year 2002. I was born in 1960, on this very day, so that makes today my birthday. Every year for my birthday, my wife Ellen would throw me a party. A kid's party. Cake, ice cream, funny hats, \"Pin the Tail on the Donkey\"."
      },
      "last": {
        "speaker": 0,
        "line": 652,
        "text": "\"Hell is oneself, Hell is alone, the other figures in it merely projections. There is nothing to escape from and nothing to escape to."
      }
    },
