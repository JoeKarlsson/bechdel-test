	"quotes": {
		"cut": [
			{
				"speaker": "DARREN & STEVE",
				"text": "Have a million questions, but right now the performance has their full edge-of-their-seat attention."
			},
			{
				"speaker": "CREPSLEY",
				"text": "Try this then. You're reckless enough to steal, responsible enough to come back for a friend. That's enough for me."
			},
			{
				"speaker": "DARREN",
				"text": "It's behind us! Crepsley bears down, the buildings streaking by. But..."
			},
			{
				"speaker": "DARREN",
				"text": "I'm afraid if I drink blood, I'll become evil. Gavner LAUGHS out loud, catches himself."
			},
			{
				"speaker": "DARREN",
				"text": "He doesn't care about me."
			}
