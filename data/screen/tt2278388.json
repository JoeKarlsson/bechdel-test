		"cut": [
			{
				"speaker": "ZERO",
				"text": "The elevator operator casts a side-ways look. Zero searches for the honest answer -- then finds it:"
			},
			{
				"speaker": "ZERO",
				"text": "M. Gustave with a look of utter astonishment on his face. He blurts out:"
			},
			{
				"speaker": "LUDWIG",
				"text": "Shut up! The convict frowns. He turns to his unseen bunk-mates and says loudly:"
			},
			{
				"speaker": "ZERO",
				"text": "I agree. Pause. M. Gustave checks his watch. He says with a slightly bitter edge to his voice:"
			},
			{
				"speaker": "AGATHA",
				"text": "Zero embraces Agatha. He kisses her passionately. He looks into her eyes. She says, woozy:"
			}
