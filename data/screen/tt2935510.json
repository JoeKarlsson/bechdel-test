	"quotes": {
		"cut": [
			{
				"speaker": "ROY MCBRIDE",
				"text": "It's what we're trained for, sir. I can't take any personal credit for that."
			},
			{
				"speaker": "ROY MCBRIDE",
				"text": "Yes, Ma'am. The chaos is real infuriating, no doubt. But we were able to engage them on their terms."
			},
			{
				"speaker": "MARS OFFICER",
				"text": "Did you bring us seeds?!? What about canned produce, did you do THAT?"
			},
			{
				"speaker": "ROY MCBRIDE",
				"text": "Please send it code, tell it that we'll proceed no further and it need not be concerned."
			},
			{
				"speaker": "ROY MCBRIDE",
				"text": "What's--what's important here is...the mission."
			}
