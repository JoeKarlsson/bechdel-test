	"quotes": {
		"cut": [
			{
				"speaker": "KING AURVANDIL",
				"text": "This night, we've made merry ..."
			},
			{
				"speaker": "BERSERKER PRIEST",
				"text": "‘Til we return to human shape, Fearless we shall drink blood from our enemies wounds."
			},
			{
