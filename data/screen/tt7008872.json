		"cut": [
			{
				"speaker": "MARSHALL",
				"text": "It’s yours. The dealership are putting me in a new Explorer Sport. You deserve it. Have fun."
			},
			{
				"speaker": "JARED",
				"text": "Oh. Cool. Um... My father... my father just paid for your lunch."
