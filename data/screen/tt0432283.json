			{
				"speaker": "KRISTOFFERSON",
				"text": "Ki-ya! Everyone looks startled. Kristofferson resumes his tae-kwon- do practice with an angry, wounded look on his face. Mrs. Fox"
			},
			{
				"speaker": "FOX",
				"text": "Think of the one thing a fox does quicker than a man, quicker than any other animal in the world!"
			},
			{
				"speaker": "FOX",
				"text": "Begin. Everyone starts digging, slowly but intently."
			},
			{
				"speaker": "BADGER",
				"text": "What was he saying about that wristwatch? I didn't get what he was talking about."
			},
			{
				"speaker": "BOGGIS",
				"text": "Franklin? You got any final twist for this plot?"
			}
		],
