	"quotes": {
		"cut": [
			{
				"speaker": "HILDY",
				"text": "That's what he did to me. Swept me right off my feet -- and left me lying on the floor."
			},
			{
				"speaker": "MOLLIE",
				"text": "It wasn't the Lord! It was the devil!"
			},
			{
				"speaker": "LOUIS",
				"text": "I didn't frisk him. He must have dropped it in Burns' office. I didn't know whose it was."
			},
			{
				"speaker": "BRUCE",
				"text": "I'm taking the nine o'clock train, Hildy. And you can meet us at the station."
			},
			{
				"speaker": "BURNS",
				"text": "Remember the time we broke into the D.A.'s office, and copied Fifi Randell's diary?"
			}
