			},
			{
				"at": 6875,
				"text": "Lord Bullingdon, have you lost your tongue?"
			},
			{
				"at": 8261,
				"text": "I see you're alone."
			},
			{
				"at": 9815,
				"text": "Is that agreeable to both of you?"
