	"quotes": {
		"cut": [
			{
				"speaker": "ORDERLY",
				"text": "Feller, indeed! The horse belongs to my captain, and he's a better fellow nor you any day."
			},
			{
				"speaker": "HARRY",
				"text": "How is it with you?"
			},
			{
				"speaker": "RODERICK",
				"text": "How do you do, sir?"
			},
			{
				"speaker": "RODERICK",
				"text": "There is no need of that. I never fire first; and, in any case, you have that right."
			},
			{
				"speaker": "RODERICK",
				"text": "Thus it is that my loyalty is rewarded, and my sacrifices in favor of my country viewed!"
			}
		],
		"notInScript": [
			{
				"at": 1743,
				"text": "Would you like something to eat?"
			},
			{
				"at": 3676,
